  {uid: "setser_feb_26_20#D3", name: "D3  Bussière et al. + chart", doc: "setser_feb_26_20", nid: "D3", date: "2020-02-26", family: "plain", type: "evidence_data", level: "L2", header: "Bussière et al. + chart", text: "Investment slowdowns lead to import slowdowns", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#D4", name: "D4  Q4 imports weak", doc: "setser_feb_26_20", nid: "D4", date: "2020-02-26", family: "plain", type: "evidence_data", level: "L2", header: "Q4 imports weak", text: "Consumer goods, autos, capital goods all soft", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#D5", name: "D5  Vietnam exports to US +$17.5B", doc: "setser_feb_26_20", nid: "D5", date: "2020-02-26", family: "plain", type: "evidence_data", level: "L2", header: "Vietnam exports to US +$17.5B", text: "Far short of the fall in China imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#E1", name: "E1  Data", doc: "setser_mar_31_20", nid: "E1", date: "2020-03-31", family: "banner", type: "evidence_data", level: "L2", header: "Data", text: "Brent under $25, below almost every exporter's breakeven; Saudi reserves ~$500bn; GCC sovereign funds over $1tn; copper at multiyear lows", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#E1", name: "E1  Data", doc: "setser_jul_8_20", nid: "E1", date: "2020-07-08", family: "banner", type: "evidence_data", level: "L2", header: "Data", text: "First-half pace implies ~$83bn, below the 2017 baseline of ~$101bn and even below 2019; energy at 7% of its target; 1m barrels a day at $40 still yields only $7.36bn", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#E1", name: "E1  Data", doc: "setser_mar_10_24", nid: "E1", date: "2024-03-10", family: "banner", type: "evidence_data", level: "L2", header: "Data", text: "Surplus at ~2% of world GDP, above peak Japan and Germany; 80% of solar panels; 35% of manufacturing output against 15% of global output", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#E1", name: "E1  Data", doc: "setser_aug_14_24", nid: "E1", date: "2024-08-14", family: "banner", type: "evidence_data", level: "L2", header: "Data", text: "Reported current account ~$150bn below expectation in Q2", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#E1", name: "E1  Data", doc: "setser_may_5_25", nid: "E1", date: "2025-05-05", family: "banner", type: "evidence_data", level: "L2", header: "Data", text: "Dollar down ~10% against the G10; a $400-550 imported phone now carries $40-110 of tariff; CNY 7.2, KRW 1400, JPY 140; 55% of China's formal reserves still in dollars", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#E1", name: "E1  Data", doc: "setser_2025-07-07_china-stealth-surplus", nid: "E1", date: "2025-07-07", family: "meta", type: "evidence_data", level: "L2", header: "Data", text: "China's 2024 current account surplus about $430 billion (just over 2 percent of GDP) versus the EU's $500 billion; goods and services surplus about $650 billion versus the EU's $620 billion; about $4 trillion in net interest-paying foreign assets, yet an investment income deficit of $150 to 200 billion; Chinese customs data show about $400 per phone; net vehicle exports above 6 million", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#E1", name: "E1  Data", doc: "setser_2025-07-28_china-eu-trade-war", nid: "E1", date: "2025-07-28", family: "meta", type: "evidence_data", level: "L2", header: "Data", text: "European exports to China down about 0.5 percentage points of European GDP; EU trade deficit with China set to double between 2020 and 2025; European auto exports to China on track for about $10 billion by 2027; Chinese electric vehicle exports at a 3 million annual pace in the second quarter; net exports added about 2 percentage points to Chinese growth over four quarters; yuan weaker against the euro", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#E1", name: "E1  Data", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "E1", date: "2025-09-12", family: "meta", type: "evidence_data", level: "L2", header: "Data", text: "Annualized trade deficit peaked at $2 trillion in March, fell to $1 trillion, then rebounded to $1.2 trillion in July; imports from Taiwan up over 50 percent year to date; first-term tariffs cut affected trade about 30 percent, and about 50 percent for goods tariffed at 25 percent; high-frequency global trade measures have not slowed", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#E1", name: "E1  Data", doc: "setser_2025-11-12_china-surplus-imf", nid: "E1", date: "2025-11-12", family: "meta", type: "evidence_data", level: "L2", header: "Data", text: "Export volumes up 40 percent since end-2019 versus imports up 1 percent; manufactured goods surplus over $2 trillion (about 10.5 percent of GDP); goods surplus $1.2 trillion; car exports over 6 million, heading toward 8 million in 2026; current account surplus 2.2 percent of GDP versus the EU's 2.6 percent; IMF forecast a 2025 surplus of $375 billion, while the actual tops $650 billion through the third quarter", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#E1", name: "E1  Data", doc: "setser_2026-02-03_october-2025-deficit", nid: "E1", date: "2026-02-03", family: "meta", type: "evidence_data", level: "L2", header: "Data", text: "October's drop came entirely from pharmaceuticals and gold; excluding them, October's deficit was slightly bigger than September's; August to October deficits below 2024, but early 2025 far above; imports of autos and household durable goods down; imports of semiconductors and computers up", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:EvidenceData {uid: c.uid}) SET n += c;

// 2 x evidence_discrepancy
UNWIND [{uid: "setser_mar_10_24#E4", name: "E4  Discrepancy", doc: "setser_mar_10_24", nid: "E4", date: "2024-03-10", family: "banner", type: "evidence_discrepancy", level: "L2", header: "Discrepancy", text: "Manufacturing surplus near 2% of world GDP against a reported current account of just 1.5% of China's own GDP", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#E4", name: "E4  Discrepancy", doc: "setser_aug_14_24", nid: "E4", date: "2024-08-14", family: "banner", type: "evidence_discrepancy", level: "L2", header: "Discrepancy", text: "Gap explodes from 2022; BoP imports exceed customs imports for the first time in 2023", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:EvidenceDiscrepancy {uid: c.uid}) SET n += c;

// 1 x evidence_rival
UNWIND [{uid: "setser_aug_14_24#E3", name: "E3  Rival measurement", doc: "setser_aug_14_24", nid: "E3", date: "2024-08-14", family: "banner", type: "evidence_rival", level: "L2", header: "Rival measurement", text: "The customs goods series against the balance-of-payments goods series", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
