UNWIND [{uid: "setser_dec_15_17#QF1", name: "QF1  Measurement caveat", doc: "setser_dec_15_17", nid: "QF1", date: "2017-12-15", family: "plain", type: "caveat", level: "L6", header: "Measurement caveat", text: "Monthly trade data are noisy and should be read as a time series", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#QF2", name: "QF2  Employment caveat", doc: "setser_dec_15_17", nid: "QF2", date: "2017-12-15", family: "plain", type: "caveat", level: "L6", header: "Employment caveat", text: "Near full employment, trade changes job distribution more than total employment", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#R1", name: "R1  Debt caveat", doc: "setser_dec_15_17", nid: "R1", date: "2017-12-15", family: "plain", type: "caveat", level: "L6", header: "Debt caveat", text: "The U.S. can sustain more external debt than most because of the dollar's global role", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#QF", name: "QF  Model uncertainty", doc: "setser_feb_15_18", nid: "QF", date: "2018-02-15", family: "plain", type: "caveat", level: "L6", header: "Model uncertainty", text: "Historical income elasticities and trade relationships may not hold perfectly", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#X", name: "X  Scale caveat", doc: "setser_jun_4_18", nid: "X", date: "2018-06-04", family: "plain", type: "caveat", level: "L6", header: "Scale caveat", text: "Argentina and Turkey are individually too small to drive the full outcome", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#QF", name: "QF  Path uncertainty", doc: "setser_jun_4_18", nid: "QF", date: "2018-06-04", family: "plain", type: "caveat", level: "L6", header: "Path uncertainty", text: "Italy and China's eventual adjustments are not predetermined", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#QF", name: "QF  Implementation caveat", doc: "setser_may_2_19", nid: "QF", date: "2019-05-02", family: "plain", type: "caveat", level: "L6", header: "Implementation caveat", text: "Controlled depreciations are difficult because markets may front-run them", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#R1", name: "R1  Retaliation risk", doc: "setser_may_2_19", nid: "R1", date: "2019-05-02", family: "plain", type: "caveat", level: "L6", header: "Retaliation risk", text: "A weaker yuan could trigger broader or higher U.S. tariffs", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#R2", name: "R2  External-balance caveat", doc: "setser_may_2_19", nid: "R2", date: "2019-05-02", family: "plain", type: "caveat", level: "L6", header: "External-balance caveat", text: "Tariffs and oil prices could push China toward current-account deficit", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#QF", name: "QF  Implementation caveat", doc: "setser_may_10_19", nid: "QF", date: "2019-05-10", family: "plain", type: "caveat", level: "L6", header: "Implementation caveat", text: "Controlled depreciations are difficult because markets may front-run them", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#R1", name: "R1  Retaliation risk", doc: "setser_may_10_19", nid: "R1", date: "2019-05-10", family: "plain", type: "caveat", level: "L6", header: "Retaliation risk", text: "A weaker yuan could trigger broader or higher U.S. tariffs", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#R2", name: "R2  External-balance caveat", doc: "setser_may_10_19", nid: "R2", date: "2019-05-10", family: "plain", type: "caveat", level: "L6", header: "External-balance caveat", text: "Tariffs and oil prices could push China toward current-account deficit", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#QF1", name: "QF1  Coverage caveat", doc: "setser_jun_14_19", nid: "QF1", date: "2019-06-14", family: "plain", type: "caveat", level: "L6", header: "Coverage caveat", text: "China had not tariffed all major U.S. manufacturing exports", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#QF2", name: "QF2  Timing caveat", doc: "setser_jun_14_19", nid: "QF2", date: "2019-06-14", family: "plain", type: "caveat", level: "L6", header: "Timing caveat", text: "China may have preserved targets for future retaliation", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#QF", name: "QF  Comparison caveat", doc: "setser_aug_13_19", nid: "QF", date: "2019-08-13", family: "plain", type: "caveat", level: "L6", header: "Comparison caveat", text: "Processing trade makes Europe-China comparisons imperfect", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#R2", name: "R2  Short-run tradeoff", doc: "setser_aug_13_19", nid: "R2", date: "2019-08-13", family: "plain", type: "caveat", level: "L6", header: "Short-run tradeoff", text: "Europe's export strength also makes it vulnerable to industrial downturns", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#QF1", name: "QF1  U.S. sustainability caveat", doc: "setser_sep_20_19", nid: "QF1", date: "2019-09-20", family: "plain", type: "caveat", level: "L6", header: "U.S. sustainability caveat", text: "The current flow deficit is not obviously unsustainable today", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#QF2", name: "QF2  China adjustment caveat", doc: "setser_sep_20_19", nid: "QF2", date: "2019-09-20", family: "plain", type: "caveat", level: "L6", header: "China adjustment caveat", text: "Fiscal and credit stimulus currently absorbs much of China's excess saving", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#QF", name: "QF  Caveat", doc: "setser_jan_31_20", nid: "QF", date: "2020-01-31", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "Tech decoupling will not bite in 2020: Boeing's own problems, no indigenous jet engines, semiconductors too early", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#QF", name: "QF  Caveat", doc: "setser_mar_31_20", nid: "QF", date: "2020-03-31", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "SDRs are allocated by quota rather than need, so they are insufficient alone; MDB capital would need legislation", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#QF", name: "QF  Caveat", doc: "setser_jul_8_20", nid: "QF", date: "2020-07-08", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "Agriculture could still deliver in Q4, which creates a real cost to abandoning the deal now", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#QF", name: "QF  Caveat", doc: "setser_mar_10_24", nid: "QF", date: "2024-03-10", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "Specialisation does partly reflect a large population and limited resources; the comprehensive data also lags and misses the 2020-2022 surge", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#QF", name: "QF  Caveat", doc: "setser_aug_14_24", nid: "QF", date: "2024-08-14", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "The income line carries no detail, so this cannot be checked from outside", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#QF", name: "QF  Caveat", doc: "setser_may_5_25", nid: "QF", date: "2025-05-05", family: "banner", type: "caveat", level: "L6", header: "Caveat", text: "The dollar is still strong by most measures; claims about the end of its reign are exaggerated", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#QF", name: "QF  Caveat", doc: "setser_2025-07-07_china-stealth-surplus", nid: "QF", date: "2025-07-07", family: "meta", type: "caveat", level: "L6", header: "Caveat", text: "Balance of payments adjustments may or may not be more accurate, and some are legitimate (insurance and freight, Airbus)", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#QF", name: "QF  Caveat", doc: "setser_2025-07-28_china-eu-trade-war", nid: "QF", date: "2025-07-28", family: "meta", type: "caveat", level: "L6", header: "Caveat", text: "The United States is still importing, which limits the damage, but American firms will not absorb tariff costs much longer", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#QF", name: "QF  Caveat", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "QF", date: "2025-09-12", family: "meta", type: "caveat", level: "L6", header: "Caveat", text: "August deals doubled tariffs on Southeast Asia relative to April; fall data may show more impact; the tariffs' legality is unresolved", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#QF", name: "QF  Caveat", doc: "setser_2025-11-12_china-surplus-imf", nid: "QF", date: "2025-11-12", family: "meta", type: "caveat", level: "L6", header: "Caveat", text: "China's GDP data are too thin to confirm the net export math; the IMF does support pro-consumption structural reforms", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#QF", name: "QF  Caveat", doc: "setser_2026-02-03_october-2025-deficit", nid: "QF", date: "2026-02-03", family: "meta", type: "caveat", level: "L6", header: "Caveat", text: "Tariffed categories really are falling; watch whether imports rebound once stockpiles are exhausted", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:Caveat {uid: c.uid}) SET n += c;

