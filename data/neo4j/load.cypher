UNWIND [{uid: "setser_dec_15_17#D1", name: "D1  2014–16 net-export drag", doc: "setser_dec_15_17", nid: "D1", date: "2017-12-15", family: "plain", type: "evidence_data", level: "L2", header: "2014–16 net-export drag", text: "Net exports subtracted about 1.5pp from U.S. growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
