// 11 x evidence_source
UNWIND [{uid: "setser_jan_31_20#E2", name: "E2  Studies & sources", doc: "setser_jan_31_20", nid: "E2", date: "2020-01-31", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "His own Senate testimony; Toloui on balance-sheet policy; the Economist on managed trade", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#E2", name: "E2  Studies & sources", doc: "setser_mar_31_20", nid: "E2", date: "2020-03-31", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "Truman on IMF lending capacity; Landers, Lee and Morris on callable capital; Hagan and Buchheit on maturity extension; Carstens and the BIS on trade finance", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#E2", name: "E2  Studies & sources", doc: "setser_jul_8_20", nid: "E2", date: "2020-07-08", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "PIIE purchase tracker; Reuters on crude loadings; S&P Global on cancelled LNG cargoes; IMF growth forecast", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#E2", name: "E2  Studies & sources", doc: "setser_mar_10_24", nid: "E2", date: "2024-03-10", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "Baldwin on sole manufacturing superpower; Pettis on production giant and consumption pygmy; Bown on the tariff timeline; OECD value-added data", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#E2", name: "E2  Studies & sources", doc: "setser_aug_14_24", nid: "E2", date: "2024-08-14", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "IMF Article IV Appendix VII; consistent with Adam Wolf's work", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#E2", name: "E2  Studies & sources", doc: "setser_may_5_25", nid: "E2", date: "2025-05-05", family: "banner", type: "evidence_source", level: "L2", header: "Studies & sources", text: "The Miran paper; IMF working paper on Lerner symmetry; SAFE 2023 annual report; Aitken on the ageing exceptionalism trade", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#E2", name: "E2  Studies and sources", doc: "setser_2025-07-07_china-stealth-surplus", nid: "E2", date: "2025-07-07", family: "meta", type: "evidence_source", level: "L2", header: "Studies and sources", text: "IMF 2024 Article IV report; China's State Administration of Foreign Exchange argument about Apple; European Central Bank (Philip Lane) analysis of Ireland; Kenneth Rogoff in the IMF's Finance and Development", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#E2", name: "E2  Studies and sources", doc: "setser_2025-07-28_china-eu-trade-war", nid: "E2", date: "2025-07-28", family: "meta", type: "evidence_source", level: "L2", header: "Studies and sources", text: "Centre for European Reform brief on German industry; Financial Times, New York Times and Wall Street Journal sector reporting; Adam Tooze; German customs data", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#E2", name: "E2  Studies and sources", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "E2", date: "2025-09-12", family: "meta", type: "evidence_source", level: "L2", header: "Studies and sources", text: "New York Times reporting; U.S. trade data; federal court ruling on tariff authority", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#E2", name: "E2  Studies and sources", doc: "setser_2025-11-12_china-surplus-imf", nid: "E2", date: "2025-11-12", family: "meta", type: "evidence_source", level: "L2", header: "Studies and sources", text: "IMF External Sector Report 2025, October World Economic Outlook and 2024 Article IV report; European Central Bank analysis; Netherlands Bureau for Economic Policy Analysis export volume data; Microsoft annual report", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#E2", name: "E2  Studies and sources", doc: "setser_2026-02-03_october-2025-deficit", nid: "E2", date: "2026-02-03", family: "meta", type: "evidence_source", level: "L2", header: "Studies and sources", text: "U.S. trade data; Section 232 semiconductor investigation", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
