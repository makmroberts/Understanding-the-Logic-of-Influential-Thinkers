UNWIND [{uid: "setser_feb_15_18#R1", name: "R1  Offsetting adjustment forces", doc: "setser_feb_15_18", nid: "R1", date: "2018-02-15", family: "plain", type: "counterpoint", level: "L6", header: "Offsetting adjustment forces", text: "Dollar depreciation and stronger foreign demand can improve U.S. trade", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
