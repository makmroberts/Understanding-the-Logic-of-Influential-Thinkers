  {uid: "setser_may_2_19#X", name: "X  Case for stability", doc: "setser_may_2_19", nid: "X", date: "2019-05-02", family: "plain", type: "counterpoint", level: "L6", header: "Case for stability", text: "China can support growth fiscally without risking a destabilizing currency move", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#X", name: "X  Case for stability", doc: "setser_may_10_19", nid: "X", date: "2019-05-10", family: "plain", type: "counterpoint", level: "L6", header: "Case for stability", text: "China can support growth fiscally without risking a destabilizing currency move", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
