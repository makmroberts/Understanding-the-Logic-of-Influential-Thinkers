// 12 x hidden_assumption
UNWIND [{uid: "setser_jan_31_20#P2", name: "P2  Hidden assumption", doc: "setser_jan_31_20", nid: "P2", date: "2020-01-31", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "The capacity to deliver purchases is the same capacity that can withdraw them", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#P1", name: "P1  Trade balance = saving − investment", doc: "setser_feb_26_20", nid: "P1", date: "2020-02-26", family: "plain", type: "hidden_assumption", level: "L1", header: "Trade balance = saving − investment", text: "Never stated, but the argument depends on it", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#P2", name: "P2  Hidden assumption", doc: "setser_mar_31_20", nid: "P2", date: "2020-03-31", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "The external balance sheet is the right thing to sort countries by", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#P2", name: "P2  Hidden assumption", doc: "setser_jul_8_20", nid: "P2", date: "2020-07-08", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "A deal with numerical targets may be judged on those targets alone", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#P2", name: "P2  Hidden assumption", doc: "setser_mar_10_24", nid: "P2", date: "2024-03-10", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "A correctly measured imbalance ought to drive policy", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#P2", name: "P2  Hidden assumption", doc: "setser_aug_14_24", nid: "P2", date: "2024-08-14", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "Customs data is ground truth — never argued for, the whole case rests on it", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#P2", name: "P2  Hidden assumption", doc: "setser_may_5_25", nid: "P2", date: "2025-05-05", family: "banner", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "Tariffs leave capital flows untouched, demand for U.S. assets is constant, and trading partners will not change their own policies", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#P3", name: "P3  Hidden assumption", doc: "setser_2025-07-07_china-stealth-surplus", nid: "P3", date: "2025-07-07", family: "meta", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "Opaque official statistics that no one can replicate deserve less trust than physical trade flows", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#P3", name: "P3  Hidden assumption", doc: "setser_2025-07-28_china-eu-trade-war", nid: "P3", date: "2025-07-28", family: "meta", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "A trading partner's surplus drains demand from your economy; manufacturing capacity has strategic value beyond its profits", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#P3", name: "P3  Hidden assumption", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "P3", date: "2025-09-12", family: "meta", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "Tax- and finance-driven flows (pharmaceuticals, gold) are noise; core trade is the real signal", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#P3", name: "P3  Hidden assumption", doc: "setser_2025-11-12_china-surplus-imf", nid: "P3", date: "2025-11-12", family: "meta", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "External balance is a legitimate policy target; exporting your way out of a slump imposes costs on other countries", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#P3", name: "P3  Hidden assumption", doc: "setser_2026-02-03_october-2025-deficit", nid: "P3", date: "2026-02-03", family: "meta", type: "hidden_assumption", level: "L1", header: "Hidden assumption", text: "The trade balance is a macroeconomic savings-investment outcome; inventory swings reverse over time", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:HiddenAssumption {uid: c.uid}) SET n += c;

// 42 x intermediate_claim
UNWIND [{uid: "setser_dec_15_17#C1", name: "C1  Trade changes the pace of growth", doc: "setser_dec_15_17", nid: "C1", date: "2017-12-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Trade changes the pace of growth", text: "A stronger economy can coexist with a deficit, but net exports still affect realized GDP growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#C2", name: "C2  Trade changes the composition of employment", doc: "setser_dec_15_17", nid: "C2", date: "2017-12-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Trade changes the composition of employment", text: "Its effects are sectoral and regional even near full employment", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#C3", name: "C3  Current debt stability is conditional", doc: "setser_dec_15_17", nid: "C3", date: "2017-12-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Current debt stability is conditional", text: "It depends on favorable growth, rates, and offshore income continuing", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#C1", name: "C1  Fiscal expansion widens the real trade deficit", doc: "setser_feb_15_18", nid: "C1", date: "2018-02-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Fiscal expansion widens the real trade deficit", text: "Import growth accelerates relative to the baseline", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#C2", name: "C2  Income channel worsens the current account", doc: "setser_feb_15_18", nid: "C2", date: "2018-02-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Income channel worsens the current account", text: "Higher interest payments add to the external deficit", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#C3", name: "C3  Favorable adjustment forces arrive too slowly", doc: "setser_feb_15_18", nid: "C3", date: "2018-02-15", family: "plain", type: "intermediate_claim", level: "L4", header: "Favorable adjustment forces arrive too slowly", text: "Foreign growth and a softer dollar cannot offset the near-term impulse", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#C1", name: "C1  EM adjustment reduces global demand support", doc: "setser_jun_4_18", nid: "C1", date: "2018-06-04", family: "plain", type: "intermediate_claim", level: "L4", header: "EM adjustment reduces global demand support", text: "Foreign economies contribute less to import growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#C2", name: "C2  Euro and Asian weakness could lift the dollar", doc: "setser_jun_4_18", nid: "C2", date: "2018-06-04", family: "plain", type: "intermediate_claim", level: "L4", header: "Euro and Asian weakness could lift the dollar", text: "Currency shifts reinforce pressure on U.S. trade", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#C3", name: "C3  The 2017 macro constellation may be ending", doc: "setser_jun_4_18", nid: "C3", date: "2018-06-04", family: "plain", type: "intermediate_claim", level: "L4", header: "The 2017 macro constellation may be ending", text: "Foreign demand may no longer offset U.S. fiscal expansion", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#C1", name: "C1  China has a genuine policy choice", doc: "setser_may_2_19", nid: "C1", date: "2019-05-02", family: "plain", type: "intermediate_claim", level: "L4", header: "China has a genuine policy choice", text: "It is not mechanically forced into depreciation", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#C2", name: "C2  Depreciation can absorb part of the tariff…", doc: "setser_may_2_19", nid: "C2", date: "2019-05-02", family: "plain", type: "intermediate_claim", level: "L4", header: "Depreciation can absorb part of the tariff shock", text: "Exporters can preserve competitiveness", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#C3", name: "C3  But depreciation carries domestic and…", doc: "setser_may_2_19", nid: "C3", date: "2019-05-02", family: "plain", type: "intermediate_claim", level: "L4", header: "But depreciation carries domestic and strategic costs", text: "It risks instability and additional U.S. retaliation", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#C4", name: "C4  A weaker yuan redistributes trade pain", doc: "setser_may_2_19", nid: "C4", date: "2019-05-02", family: "plain", type: "intermediate_claim", level: "L4", header: "A weaker yuan redistributes trade pain", text: "Export-dependent economies outside China also come under pressure", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#C1", name: "C1  China has a genuine policy choice", doc: "setser_may_10_19", nid: "C1", date: "2019-05-10", family: "plain", type: "intermediate_claim", level: "L4", header: "China has a genuine policy choice", text: "It is not mechanically forced into depreciation", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#C2", name: "C2  Depreciation can absorb part of the tariff…", doc: "setser_may_10_19", nid: "C2", date: "2019-05-10", family: "plain", type: "intermediate_claim", level: "L4", header: "Depreciation can absorb part of the tariff shock", text: "Exporters can preserve competitiveness", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#C3", name: "C3  But depreciation carries domestic and…", doc: "setser_may_10_19", nid: "C3", date: "2019-05-10", family: "plain", type: "intermediate_claim", level: "L4", header: "But depreciation carries domestic and strategic costs", text: "It risks instability and additional U.S. retaliation", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#C4", name: "C4  A weaker yuan redistributes trade pain", doc: "setser_may_10_19", nid: "C4", date: "2019-05-10", family: "plain", type: "intermediate_claim", level: "L4", header: "A weaker yuan redistributes trade pain", text: "Export-dependent economies outside China also come under pressure", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#C1", name: "C1  Soy retaliation was unusually effective", doc: "setser_jun_14_19", nid: "C1", date: "2019-06-14", family: "plain", type: "intermediate_claim", level: "L4", header: "Soy retaliation was unusually effective", text: "Bilateral losses became aggregate export losses", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#C2", name: "C2  Oil retaliation mostly redirected trade", doc: "setser_jun_14_19", nid: "C2", date: "2019-06-14", family: "plain", type: "intermediate_claim", level: "L4", header: "Oil retaliation mostly redirected trade", text: "Bilateral trade fell without much aggregate effect", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#C3", name: "C3  Manufacturing retaliation was weaker", doc: "setser_jun_14_19", nid: "C3", date: "2019-06-14", family: "plain", type: "intermediate_claim", level: "L4", header: "Manufacturing retaliation was weaker", text: "China had limited leverage in several key sectors", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#C4", name: "C4  Identical tariffs need not have identical…", doc: "setser_jun_14_19", nid: "C4", date: "2019-06-14", family: "plain", type: "intermediate_claim", level: "L4", header: "Identical tariffs need not have identical effects", text: "Sector structure changes the transmission", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#C1", name: "C1  The U.S.-Europe gap is mainly an export gap", doc: "setser_aug_13_19", nid: "C1", date: "2019-08-13", family: "plain", type: "intermediate_claim", level: "L4", header: "The U.S.-Europe gap is mainly an export gap", text: "U.S. imports are not unusually high relative to Europe", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#C2", name: "C2  U.S. globalization favored offshore profits", doc: "setser_aug_13_19", nid: "C2", date: "2019-08-13", family: "plain", type: "intermediate_claim", level: "L4", header: "U.S. globalization favored offshore profits", text: "More than domestically produced manufacturing exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#C3", name: "C3  Europe's strength creates cyclical exposure", doc: "setser_aug_13_19", nid: "C3", date: "2019-08-13", family: "plain", type: "intermediate_claim", level: "L4", header: "Europe's strength creates cyclical exposure", text: "Its export model is vulnerable when global manufacturing slows", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#C4", name: "C4  China's manufacturing model is unusually…", doc: "setser_aug_13_19", nid: "C4", date: "2019-08-13", family: "plain", type: "intermediate_claim", level: "L4", header: "China's manufacturing model is unusually one-sided", text: "Large exports coexist with relatively small manufactured imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#C1", name: "C1  Europe's imbalance is mainly a demand problem", doc: "setser_sep_20_19", nid: "C1", date: "2019-09-20", family: "plain", type: "intermediate_claim", level: "L4", header: "Europe's imbalance is mainly a demand problem", text: "Looser fiscal policy could directly raise domestic absorption", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#C2", name: "C2  East Asia's imbalance is structurally harder", doc: "setser_sep_20_19", nid: "C2", date: "2019-09-20", family: "plain", type: "intermediate_claim", level: "L4", header: "East Asia's imbalance is structurally harder", text: "China's underlying problem is exceptionally high saving", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#C3", name: "C3  China's current adjustment is fragile", doc: "setser_sep_20_19", nid: "C3", date: "2019-09-20", family: "plain", type: "intermediate_claim", level: "L4", header: "China's current adjustment is fragile", text: "Large public investment prevents an even larger external surplus", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#C4", name: "C4  The U.S. cannot absorb surpluses forever", doc: "setser_sep_20_19", nid: "C4", date: "2019-09-20", family: "plain", type: "intermediate_claim", level: "L4", header: "The U.S. cannot absorb surpluses forever", text: "Its external debt stock is already large relative to exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#C1", name: "C1  Intermediate claim", doc: "setser_jan_31_20", nid: "C1", date: "2020-01-31", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Five parallel verdicts: industrial policy untouched, currency buffered, Treasuries unused, manufactures spared, ag and energy targeted", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#C1", name: "C1  Tariffs cut the deficit by slowing growth", doc: "setser_feb_26_20", nid: "C1", date: "2020-02-26", family: "plain", type: "intermediate_claim", level: "L4", header: "Tariffs cut the deficit by slowing growth", text: "Not the argument Trump makes for them", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#C2", name: "C2  Diversion no longer offsets China", doc: "setser_feb_26_20", nid: "C2", date: "2020-02-26", family: "plain", type: "intermediate_claim", level: "L4", header: "Diversion no longer offsets China", text: "Imports from other countries stopped making up the gap", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#C1", name: "C1  Intermediate claim", doc: "setser_mar_31_20", nid: "C1", date: "2020-03-31", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Countries with strong external balance sheets can weather this themselves if they act decisively", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#C1", name: "C1  Intermediate claim", doc: "setser_jul_8_20", nid: "C1", date: "2020-07-08", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Category by category: manufacturing will not close the gap, agriculture is behind but Q4 is still live, energy is effectively impossible", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#C1", name: "C1  Intermediate claim", doc: "setser_mar_10_24", nid: "C1", date: "2024-03-10", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "The counterpart to the surplus is the United States, not commodity exporters, and the gap keeps widening as a share of world GDP", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#C1", name: "C1  Intermediate claim", doc: "setser_aug_14_24", nid: "C1", date: "2024-08-14", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "It makes no economic sense; the offsetting adjustment is absent; the series cannot be replicated", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#C1", name: "C1  Intermediate claim", doc: "setser_may_5_25", nid: "C1", date: "2025-05-05", family: "banner", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Each of the five channels is plausible and none is decisive on its own", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#C1", name: "C1  Intermediate claim", doc: "setser_2025-07-07_china-stealth-surplus", nid: "C1", date: "2025-07-07", family: "meta", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Current account comparisons based on balance of payments data make Europe, not China, look like the main source of imbalance", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#C1", name: "C1  Intermediate claim", doc: "setser_2025-07-28_china-eu-trade-war", nid: "C1", date: "2025-07-28", family: "meta", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "The second China shock is eroding Europe's core export sectors and is large enough to matter for the whole economy, especially Germany's stagnation", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#C1", name: "C1  Intermediate claim", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "C1", date: "2025-09-12", family: "meta", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Excluding pharmaceuticals and gold, U.S. imports are roughly on trend; the shock to trade rules far exceeds the shock to trade flows", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#C1", name: "C1  Intermediate claim", doc: "setser_2025-11-12_china-surplus-imf", nid: "C1", date: "2025-11-12", family: "meta", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "China's surplus is massive and growing, yet IMF policy advice effectively lets China export its way out of its housing slump", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#C1", name: "C1  Intermediate claim", doc: "setser_2026-02-03_october-2025-deficit", nid: "C1", date: "2026-02-03", family: "meta", type: "intermediate_claim", level: "L4", header: "Intermediate claim", text: "Tariffs reduce imports in specific categories, but the overall deficit is driven by untariffed goods and stockpile timing", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:IntermediateClaim {uid: c.uid}) SET n += c;

// 21 x main_claim
UNWIND [{uid: "setser_dec_15_17#K", name: "K  Main claim: the trade balance remains worth…", doc: "setser_dec_15_17", nid: "K", date: "2017-12-15", family: "plain", type: "main_claim", level: "L5", header: "Main claim: the trade balance remains worth watching", text: "It contains information about growth, employment composition,\nand long-run external debt sustainability", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#K", name: "K  Main claim: the tax bill sets back Trump's…", doc: "setser_feb_15_18", nid: "K", date: "2018-02-15", family: "plain", type: "main_claim", level: "L5", header: "Main claim: the tax bill sets back Trump's trade goals", text: "U.S. fiscal stimulus boosts imports just as conditions\nwere emerging for the trade deficit to improve", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#K", name: "K  Main claim: macro shocks could overpower…", doc: "setser_jun_4_18", nid: "K", date: "2018-06-04", family: "plain", type: "main_claim", level: "L5", header: "Main claim: macro shocks could overpower trade deals", text: "The U.S. trade deficit could rise even if the administration\nsecures new trade agreements", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#K", name: "K  Main claim: China's currency response is a…", doc: "setser_may_2_19", nid: "K", date: "2019-05-02", family: "plain", type: "main_claim", level: "L5", header: "Main claim: China's currency response is a strategic choice", text: "Beijing can defend stability or reset the yuan lower;\nits decision will shape the global impact of the trade war", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#K", name: "K  Main claim: China's currency response is a…", doc: "setser_may_10_19", nid: "K", date: "2019-05-10", family: "plain", type: "main_claim", level: "L5", header: "Main claim: China's currency response is a strategic choice", text: "Beijing can defend stability or reset the yuan lower;\nits decision will shape the global impact of the trade war", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#K", name: "K  Main claim: don't equate bilateral trade…", doc: "setser_jun_14_19", nid: "K", date: "2019-06-14", family: "plain", type: "main_claim", level: "L5", header: "Main claim: don't equate bilateral trade with aggregate impact", text: "The economic effect of tariffs depends heavily\non substitution possibilities and sector structure", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#K1", name: "K1  Long-run U.S. claim", doc: "setser_aug_13_19", nid: "K1", date: "2019-08-13", family: "plain", type: "main_claim", level: "L5", header: "Long-run U.S. claim", text: "The U.S. may need to rebuild a stronger manufacturing base rather than finance imports indefinitely", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#K2", name: "K2  Comparative claim", doc: "setser_aug_13_19", nid: "K2", date: "2019-08-13", family: "plain", type: "main_claim", level: "L5", header: "Comparative claim", text: "Europe and China remain far more manufacturing-oriented,\nbut with very different import structures", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#K", name: "K  Main claim: global imbalances could worsen…", doc: "setser_sep_20_19", nid: "K", date: "2019-09-20", family: "plain", type: "main_claim", level: "L5", header: "Main claim: global imbalances could worsen first", text: "Europe still lacks demand and China's excess-saving problem remains;\nthe U.S. cannot indefinitely absorb the resulting surpluses", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#K", name: "K  Main claim", doc: "setser_jan_31_20", nid: "K", date: "2020-01-31", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\nChina can meet its 2020 commitments — and that is precisely the risk.\n\"What China's state gives, China's state can take away\"", type_source: "header", claim_type: "single", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#K", name: "K  Main claim: the US demand shock was exported", doc: "setser_feb_26_20", nid: "K", date: "2020-02-26", family: "plain", type: "main_claim", level: "L5", header: "Main claim: the US demand shock was exported", text: "Setser: \"the weakening of U.S. demand was felt globally,\nrather than in the United States\"\nUS GDP held because services demand stayed strong", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#K", name: "K  Main claim", doc: "setser_mar_31_20", nid: "K", date: "2020-03-31", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\n\"Different problems require different solutions\" — when private capital retreats, the official sector must advance", type_source: "header", claim_type: "typology", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#K", name: "K  Main claim", doc: "setser_jul_8_20", nid: "K", date: "2020-07-08", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\nThe deal is failing on its own terms — insisting on impressive numbers made the shortfall easy to demonstrate", type_source: "header", claim_type: "single", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#K", name: "K  Main claim", doc: "setser_mar_10_24", nid: "K", date: "2024-03-10", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\nThe imbalance is large, growing and mismeasured — it shows up everywhere except in the reported current account and in the IMF's analysis", type_source: "header", claim_type: "single", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#K", name: "K  Main claim", doc: "setser_aug_14_24", nid: "K", date: "2024-08-14", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\nThe reported surplus is an artifact of a methodology change", type_source: "header", claim_type: "single", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#K", name: "K  Main claim", doc: "setser_may_5_25", nid: "K", date: "2025-05-05", family: "banner", type: "main_claim", level: "L5", header: "Main claim", text: "·\n\"In a sense, the dollar's recent weakness is over-determined\" — he declines to choose", type_source: "header", claim_type: "unresolved", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#K", name: "K  Main claim", doc: "setser_2025-07-07_china-stealth-surplus", nid: "K", date: "2025-07-07", family: "meta", type: "main_claim", level: "L5", header: "Main claim", text: "The real imbalance is in China; the IMF and G7 should focus there", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#K", name: "K  Main claim", doc: "setser_2025-07-28_china-eu-trade-war", nid: "K", date: "2025-07-28", family: "meta", type: "main_claim", level: "L5", header: "Main claim", text: "China is winning a trade war with Europe; Europe needs a counter-industrial policy, broader tariffs on Chinese autos and new pressure for the yuan to rise", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#K", name: "K  Main claim", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "K", date: "2025-09-12", family: "meta", type: "main_claim", level: "L5", header: "Main claim", text: "The Trump shock to trade flows has not happened yet, though a modest impact should appear", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#K", name: "K  Main claim", doc: "setser_2025-11-12_china-surplus-imf", nid: "K", date: "2025-11-12", family: "meta", type: "main_claim", level: "L5", header: "Main claim", text: "The IMF should recognize China's external imbalance and call for a fiscal expansion funded by the central government", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#K", name: "K  Main claim", doc: "setser_2026-02-03_october-2025-deficit", nid: "K", date: "2026-02-03", family: "meta", type: "main_claim", level: "L5", header: "Main claim", text: "No: the low October deficit is not evidence the tariffs work, and a significant fall in the 2025 deficit is unlikely", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:MainClaim {uid: c.uid}) SET n += c;

// 59 x mechanism
UNWIND [{uid: "setser_dec_15_17#M1", name: "M1  Trade deficits can drag on growth", doc: "setser_dec_15_17", nid: "M1", date: "2017-12-15", family: "plain", type: "mechanism", level: "L3", header: "Trade deficits can drag on growth", text: "More demand leaks abroad through net imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#M2", name: "M2  Trade shifts where jobs are located", doc: "setser_dec_15_17", nid: "M2", date: "2017-12-15", family: "plain", type: "mechanism", level: "L3", header: "Trade shifts where jobs are located", text: "Manufacturing deficits reduce employment in exposed sectors and regions", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#M3", name: "M3  Deficits build external debt", doc: "setser_dec_15_17", nid: "M3", date: "2017-12-15", family: "plain", type: "mechanism", level: "L3", header: "Deficits build external debt", text: "Persistent borrowing plus higher interest costs raise the external debt burden", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#M1", name: "M1  Stimulus raises imports", doc: "setser_feb_15_18", nid: "M1", date: "2018-02-15", family: "plain", type: "mechanism", level: "L3", header: "Stimulus raises imports", text: "Stronger U.S. demand spills into foreign production", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#M2", name: "M2  Higher rates raise external interest costs", doc: "setser_feb_15_18", nid: "M2", date: "2018-02-15", family: "plain", type: "mechanism", level: "L3", header: "Higher rates raise external interest costs", text: "More income flows abroad on the U.S. debt stock", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#M3", name: "M3  Dollar depreciation improves trade slowly", doc: "setser_feb_15_18", nid: "M3", date: "2018-02-15", family: "plain", type: "mechanism", level: "L3", header: "Dollar depreciation improves trade slowly", text: "Exports rise and imports soften only after substantial lags", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#M1", name: "M1  Foreign adjustment weakens demand", doc: "setser_jun_4_18", nid: "M1", date: "2018-06-04", family: "plain", type: "mechanism", level: "L3", header: "Foreign adjustment weakens demand", text: "Lower domestic spending abroad reduces demand for imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#M2", name: "M2  Weaker foreign currencies strengthen the…", doc: "setser_jun_4_18", nid: "M2", date: "2018-06-04", family: "plain", type: "mechanism", level: "L3", header: "Weaker foreign currencies strengthen the dollar", text: "Dollar strength hurts U.S. trade competitiveness", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#M3", name: "M3  Demand divergence widens the U.S. deficit", doc: "setser_jun_4_18", nid: "M3", date: "2018-06-04", family: "plain", type: "mechanism", level: "L3", header: "Demand divergence widens the U.S. deficit", text: "Strong U.S. demand plus weak foreign demand raises net imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#M1", name: "M1  Tariffs weaken Chinese export demand", doc: "setser_may_2_19", nid: "M1", date: "2019-05-02", family: "plain", type: "mechanism", level: "L3", header: "Tariffs weaken Chinese export demand", text: "Higher U.S. import costs reduce competitiveness and growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#M2", name: "M2  Depreciation cushions exporters", doc: "setser_may_2_19", nid: "M2", date: "2019-05-02", family: "plain", type: "mechanism", level: "L3", header: "Depreciation cushions exporters", text: "A weaker yuan offsets part of the tariff in dollar terms", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#M3", name: "M3  Stability protects domestic confidence", doc: "setser_may_2_19", nid: "M3", date: "2019-05-02", family: "plain", type: "mechanism", level: "L3", header: "Stability protects domestic confidence", text: "Avoiding a large currency move limits financial instability", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#M4", name: "M4  Yuan weakness spreads outward", doc: "setser_may_2_19", nid: "M4", date: "2019-05-02", family: "plain", type: "mechanism", level: "L3", header: "Yuan weakness spreads outward", text: "Other Asian currencies weaken and trade pressure shifts globally", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#M1", name: "M1  Tariffs weaken Chinese export demand", doc: "setser_may_10_19", nid: "M1", date: "2019-05-10", family: "plain", type: "mechanism", level: "L3", header: "Tariffs weaken Chinese export demand", text: "Higher U.S. import costs reduce competitiveness and growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#M2", name: "M2  Depreciation cushions exporters", doc: "setser_may_10_19", nid: "M2", date: "2019-05-10", family: "plain", type: "mechanism", level: "L3", header: "Depreciation cushions exporters", text: "A weaker yuan offsets part of the tariff in dollar terms", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#M3", name: "M3  Stability protects domestic confidence", doc: "setser_may_10_19", nid: "M3", date: "2019-05-10", family: "plain", type: "mechanism", level: "L3", header: "Stability protects domestic confidence", text: "Avoiding a large currency move limits financial instability", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#M4", name: "M4  Yuan weakness spreads outward", doc: "setser_may_10_19", nid: "M4", date: "2019-05-10", family: "plain", type: "mechanism", level: "L3", header: "Yuan weakness spreads outward", text: "Other Asian currencies weaken and trade pressure shifts globally", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#M1", name: "M1  Few alternative buyers magnify the shock", doc: "setser_jun_14_19", nid: "M1", date: "2019-06-14", family: "plain", type: "mechanism", level: "L3", header: "Few alternative buyers magnify the shock", text: "Lost Chinese demand becomes lost total exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#M2", name: "M2  Alternative buyers divert trade", doc: "setser_jun_14_19", nid: "M2", date: "2019-06-14", family: "plain", type: "mechanism", level: "L3", header: "Alternative buyers divert trade", text: "Sales shift markets without reducing total exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#M3", name: "M3  Lack of substitutes weakens retaliation", doc: "setser_jun_14_19", nid: "M3", date: "2019-06-14", family: "plain", type: "mechanism", level: "L3", header: "Lack of substitutes weakens retaliation", text: "Chinese firms continue buying needed U.S. goods", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#M4", name: "M4  Other demand can absorb export losses", doc: "setser_jun_14_19", nid: "M4", date: "2019-06-14", family: "plain", type: "mechanism", level: "L3", header: "Other demand can absorb export losses", text: "Domestic sales or localization cushion production", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#M1", name: "M1  Offshoring weakens domestic exports", doc: "setser_aug_13_19", nid: "M1", date: "2019-08-13", family: "plain", type: "mechanism", level: "L3", header: "Offshoring weakens domestic exports", text: "'Design here, make abroad' shifts manufacturing production overseas", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#M2", name: "M2  Offshore profits finance goods deficits", doc: "setser_aug_13_19", nid: "M2", date: "2019-08-13", family: "plain", type: "mechanism", level: "L3", header: "Offshore profits finance goods deficits", text: "Foreign earnings offset part of the manufacturing import bill", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#M3", name: "M3  Export dependence transmits global weakness", doc: "setser_aug_13_19", nid: "M3", date: "2019-08-13", family: "plain", type: "mechanism", level: "L3", header: "Export dependence transmits global weakness", text: "Manufacturing downturns hit Europe especially hard", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#M4", name: "M4  Low imports + high exports generate surplus", doc: "setser_aug_13_19", nid: "M4", date: "2019-08-13", family: "plain", type: "mechanism", level: "L3", header: "Low imports + high exports generate surplus", text: "China sells far more manufactures abroad than it buys", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#M1", name: "M1  Fiscal restraint suppresses domestic demand", doc: "setser_sep_20_19", nid: "M1", date: "2019-09-20", family: "plain", type: "mechanism", level: "L3", header: "Fiscal restraint suppresses domestic demand", text: "Lower imports and excess saving generate European surpluses", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#M2", name: "M2  Structural high saving generates surplus…", doc: "setser_sep_20_19", nid: "M2", date: "2019-09-20", family: "plain", type: "mechanism", level: "L3", header: "Structural high saving generates surplus pressure", text: "China saves more than its economy can sustainably absorb", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#M3", name: "M3  Weak investment and imports raise China's…", doc: "setser_sep_20_19", nid: "M3", date: "2019-09-20", family: "plain", type: "mechanism", level: "L3", header: "Weak investment and imports raise China's surplus", text: "Less domestic absorption pushes the external balance upward", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#M4", name: "M4  Foreign surpluses require deficit absorption", doc: "setser_sep_20_19", nid: "M4", date: "2019-09-20", family: "plain", type: "mechanism", level: "L3", header: "Foreign surpluses require deficit absorption", text: "North America takes the other side through external deficits and debt", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#M1", name: "M1  Mechanism A", doc: "setser_jan_31_20", nid: "M1", date: "2020-01-31", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\nOutflow controls and the absence of carry-trade leverage prevented a 2015-style panic", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#M2", name: "M2  Mechanism B", doc: "setser_jan_31_20", nid: "M2", date: "2020-01-31", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nTreasuries carry no leverage — if China pushed yields up, the Fed would simply react", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#M1", name: "M1  Tariffs act as a consumption tax", doc: "setser_feb_26_20", nid: "M1", date: "2020-02-26", family: "plain", type: "mechanism", level: "L3", header: "Tariffs act as a consumption tax", text: "Backdoor fiscal tightening slows consumption", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#M2", name: "M2  Uncertainty cuts capex", doc: "setser_feb_26_20", nid: "M2", date: "2020-02-26", family: "plain", type: "mechanism", level: "L3", header: "Uncertainty cuts capex", text: "Especially new business equipment", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#M3", name: "M3  Lower capex → lower imports", doc: "setser_feb_26_20", nid: "M3", date: "2020-02-26", family: "plain", type: "mechanism", level: "L3", header: "Lower capex → lower imports", text: "Weaker investment means fewer imported goods", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#M1", name: "M1  Mechanism A", doc: "setser_mar_31_20", nid: "M1", date: "2020-03-31", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\nThe same four shocks land very differently depending on the external balance sheet", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#M2", name: "M2  Mechanism B", doc: "setser_mar_31_20", nid: "M2", date: "2020-03-31", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nSwap lines solve dollar funding, but were never designed to cover a balance-of-payments shortfall", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#M1", name: "M1  Mechanism A", doc: "setser_jul_8_20", nid: "M1", date: "2020-07-08", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\nThere is no policy lever in manufacturing — import substitution continues and trade does not run through a few buyers", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#M2", name: "M2  Mechanism B", doc: "setser_jul_8_20", nid: "M2", date: "2020-07-08", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nSeasonality blocks catch-up, and because targets are nominal a commodity price crash widens the gap without any change in volume", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#M1", name: "M1  Mechanism A", doc: "setser_mar_10_24", nid: "M1", date: "2024-03-10", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\nPolicy, not only comparative advantage — resistance to consumer stimulus and a thin safety net sustain a savings surplus", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#M2", name: "M2  Mechanism B", doc: "setser_mar_10_24", nid: "M2", date: "2024-03-10", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nUpgrading is the stated growth plan, so advanced manufacturing capacity keeps expanding", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#M1", name: "M1  Mechanism A", doc: "setser_aug_14_24", nid: "M1", date: "2024-08-14", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\n\"Factoryless\" manufacturing — a sale to a non-resident is booked as an export though the goods never leave China", type_source: "header", claim_type: "", mechanism_kind: "distortion", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#M2", name: "M2  Mechanism B", doc: "setser_aug_14_24", nid: "M2", date: "2024-08-14", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nCompilers switched from customs data to direct enterprise reporting in 2022", type_source: "header", claim_type: "", mechanism_kind: "distortion", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#M1", name: "M1  Mechanism A", doc: "setser_may_5_25", nid: "M1", date: "2025-05-05", family: "banner", type: "mechanism", level: "L3", header: "Mechanism A", text: "·\nFive channels at once — tariffs as fiscal tightening, recession risk hitting equities, China declining to let the yuan slide, Europe's fiscal turn, and a risk premium from treating allies as adversaries", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#M2", name: "M2  Mechanism B", doc: "setser_may_5_25", nid: "M2", date: "2025-05-05", family: "banner", type: "mechanism", level: "L3", header: "Mechanism B", text: "·\nThe dollar was priced for perfection: the flow equilibrium needed ever-larger inflows at ever-higher valuations", type_source: "header", claim_type: "", mechanism_kind: "economic", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#M1", name: "M1  China understated", doc: "setser_2025-07-07_china-stealth-surplus", nid: "M1", date: "2025-07-07", family: "meta", type: "mechanism", level: "L3", header: "China understated", text: "An unexplained 2021 break in China's balance of payments goods series and an unexplained investment income deficit shrink China's reported current account", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "bop-understates-china-surplus"},
  {uid: "setser_2025-07-07_china-stealth-surplus#M2", name: "M2  EU overstated", doc: "setser_2025-07-07_china-stealth-surplus", nid: "M2", date: "2025-07-07", family: "meta", type: "mechanism", level: "L3", header: "EU overstated", text: "U.S. multinationals in Ireland (Apple, pharmaceutical companies) inflate the EU's goods surplus and hide its investment income surplus", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#M1", name: "M1  Overcapacity", doc: "setser_2025-07-28_china-eu-trade-war", nid: "M1", date: "2025-07-28", family: "meta", type: "mechanism", level: "L3", header: "Overcapacity", text: "Competing local governments add subsidized capacity, which drives profits down and pushes output China cannot absorb into exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#M2", name: "M2  Weak currency", doc: "setser_2025-07-28_china-eu-trade-war", nid: "M2", date: "2025-07-28", family: "meta", type: "mechanism", level: "L3", header: "Weak currency", text: "State banks keep the yuan weak; its fall against the euro has roughly offset the EU's 17 percent countervailing duty on BYD", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#M1", name: "M1  Front-running", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "M1", date: "2025-09-12", family: "meta", type: "mechanism", level: "L3", header: "Front-running", text: "Pharmaceutical stockpiling (distorted by tax) and gold flows drive the headline swings", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#M2", name: "M2  Trade diversion", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "M2", date: "2025-09-12", family: "meta", type: "mechanism", level: "L3", header: "Trade diversion", text: "Imports shift from China to Taiwan and Southeast Asia as final assembly relocates", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#M3", name: "M3  Artificial intelligence investment", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "M3", date: "2025-09-12", family: "meta", type: "mechanism", level: "L3", header: "Artificial intelligence investment", text: "The data center buildout pushes electronics imports up", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#M4", name: "M4  Elasticity math", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "M4", date: "2025-09-12", family: "meta", type: "mechanism", level: "L3", header: "Elasticity math", text: "A 15 percent tariff times a 0.3 to 0.4 elasticity cuts imports 5 to 6 percent; non-oil imports fall from about 10 to 9.5 percent of GDP", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#M1", name: "M1  Demand shortfall", doc: "setser_2025-11-12_china-surplus-imf", nid: "M1", date: "2025-11-12", family: "meta", type: "mechanism", level: "L3", header: "Demand shortfall", text: "Weak domestic demand leaves spare capacity for exports; rate cuts lower yields and weaken the yuan, widening the surplus", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#M2", name: "M2  Mismeasurement", doc: "setser_2025-11-12_china-surplus-imf", nid: "M2", date: "2025-11-12", family: "meta", type: "mechanism", level: "L3", header: "Mismeasurement", text: "The 2022 balance of payments methodology and the unexplained income deficit each cut about 1 percentage point of GDP from the reported current account surplus", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "bop-understates-china-surplus"},
  {uid: "setser_2025-11-12_china-surplus-imf#M3", name: "M3  IMF lens", doc: "setser_2025-11-12_china-surplus-imf", nid: "M3", date: "2025-11-12", family: "meta", type: "mechanism", level: "L3", header: "IMF lens", text: "Relying only on the reported current account frames China's problem as purely internal, so the IMF prescribes monetary easing", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#M1", name: "M1  Tariff fears", doc: "setser_2026-02-03_october-2025-deficit", nid: "M1", date: "2026-02-03", family: "meta", type: "mechanism", level: "L3", header: "Tariff fears", text: "Fear of tariffs that never came drove pharmaceutical stockpiling and gold flowing out and back", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#M2", name: "M2  Inventory drawdown", doc: "setser_2026-02-03_october-2025-deficit", nid: "M2", date: "2026-02-03", family: "meta", type: "mechanism", level: "L3", header: "Inventory drawdown", text: "Stockpiles built ahead of tariffs temporarily depress imports, and stockpiles run out", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#M3", name: "M3  Untariffed artificial intelligence investment", doc: "setser_2026-02-03_october-2025-deficit", nid: "M3", date: "2026-02-03", family: "meta", type: "mechanism", level: "L3", header: "Untariffed artificial intelligence investment", text: "The data center buildout keeps semiconductor and computer imports rising", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#M4", name: "M4  Fiscal channel", doc: "setser_2026-02-03_october-2025-deficit", nid: "M4", date: "2026-02-03", family: "meta", type: "mechanism", level: "L3", header: "Fiscal channel", text: "Promised refund checks and pressure for more defense spending block a fiscal adjustment", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:Mechanism {uid: c.uid}) SET n += c;

// 13 x opposing_view
UNWIND [{uid: "setser_dec_15_17#X", name: "X  Opposing view", doc: "setser_dec_15_17", nid: "X", date: "2017-12-15", family: "plain", type: "opposing_view", level: "L6", header: "Opposing view", text: "A wider deficit can reflect stronger domestic demand rather than weakness", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#X", name: "X  Smaller-spillover argument", doc: "setser_feb_15_18", nid: "X", date: "2018-02-15", family: "plain", type: "opposing_view", level: "L6", header: "Smaller-spillover argument", text: "The U.S. is relatively closed and much of the tax cut may be saved", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#X", name: "X  Opposing view", doc: "setser_jan_31_20", nid: "X", date: "2020-01-31", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "Both approaches carry costs — managed trade rewards diversion away from allies, while the conventional approach changed little in 2010-11", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#X", name: "X  Opposing view", doc: "setser_mar_31_20", nid: "X", date: "2020-03-31", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "Private creditors would rather be paid — \"this will take goodwill\"", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#X", name: "X  Opposing view", doc: "setser_jul_8_20", nid: "X", date: "2020-07-08", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "Raised up front and rebutted: \"the purchase commitments themselves were a mistake\" and \"COVID-19 changed everything\". A barrier-removal deal might have worked — but would not have produced a big number", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#X", name: "X  Opposing view", doc: "setser_mar_10_24", nid: "X", date: "2024-03-10", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "The standard view that the post-crisis fall in China's current account means external imbalances are no longer pressing", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#X", name: "X  Opposing view", doc: "setser_aug_14_24", nid: "X", date: "2024-08-14", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "Analysts and the IMF read the post-2021 decline as real", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#X", name: "X  Opposing view", doc: "setser_may_5_25", nid: "X", date: "2025-05-05", family: "banner", type: "opposing_view", level: "L6", header: "Opposing view", text: "The consensus he started from — that tariffs mechanically lift the dollar", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#X", name: "X  Opposing view", doc: "setser_2025-07-07_china-stealth-surplus", nid: "X", date: "2025-07-07", family: "meta", type: "opposing_view", level: "L6", header: "Opposing view", text: "The IMF and analysts using comprehensive goods and services data, who see the EU as the biggest contributor", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#X", name: "X  Opposing view", doc: "setser_2025-07-28_china-eu-trade-war", nid: "X", date: "2025-07-28", family: "meta", type: "opposing_view", level: "L6", header: "Opposing view", text: "Europe's inadequate response so far; Trump-style tariffs or commodity purchase deals as the fix", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#X", name: "X  Opposing view", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "X", date: "2025-09-12", family: "meta", type: "opposing_view", level: "L6", header: "Opposing view", text: "Reading headline volatility as tariffs crushing trade", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#X", name: "X  Opposing view", doc: "setser_2025-11-12_china-surplus-imf", nid: "X", date: "2025-11-12", family: "meta", type: "opposing_view", level: "L6", header: "Opposing view", text: "The IMF's framing; the argument that Europe's surplus is almost as big", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#X", name: "X  Opposing view", doc: "setser_2026-02-03_october-2025-deficit", nid: "X", date: "2026-02-03", family: "meta", type: "opposing_view", level: "L6", header: "Opposing view", text: "Trump's trade team claiming success from smaller deficits than in the same months of 2024", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:OpposingView {uid: c.uid}) SET n += c;

// 11 x other_explanation
UNWIND [{uid: "setser_aug_13_19#X", name: "X  Services explanation", doc: "setser_aug_13_19", nid: "X", date: "2019-08-13", family: "plain", type: "other_explanation", level: "L6", header: "Services explanation", text: "Some attribute the U.S. goods deficit to comparative advantage in services", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#R1", name: "R1  Resource-endowment explanation", doc: "setser_aug_13_19", nid: "R1", date: "2019-08-13", family: "plain", type: "other_explanation", level: "L6", header: "Resource-endowment explanation", text: "The shale boom reduces the need to export manufactures to pay for oil", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#X", name: "X  U.S.-adjustment alternative", doc: "setser_sep_20_19", nid: "X", date: "2019-09-20", family: "plain", type: "other_explanation", level: "L6", header: "U.S.-adjustment alternative", text: "Tighter U.S. fiscal policy would also reduce the American trade deficit", type_source: "l6_keyword", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#R1", name: "R1  Other explanation", doc: "setser_jan_31_20", nid: "R1", date: "2020-01-31", family: "banner", type: "other_explanation", level: "L6", header: "Other explanation", text: "Why were manufactures spared? \"I am not quite sure why this is the case\" — two theories offered, neither chosen", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#R1", name: "R1  Other explanation", doc: "setser_jul_8_20", nid: "R1", date: "2020-07-08", family: "banner", type: "other_explanation", level: "L6", header: "Other explanation", text: "The aircraft collapse is exogenous — the largest category fell with the 737 MAX grounding, not with the deal", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#R1", name: "R1  Other explanation", doc: "setser_may_5_25", nid: "R1", date: "2025-05-05", family: "banner", type: "other_explanation", level: "L6", header: "Other explanation", text: "The five theories function as rivals to each other, and he keeps all of them live", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#R1", name: "R1  Other explanation", doc: "setser_2025-07-07_china-stealth-surplus", nid: "R1", date: "2025-07-07", family: "meta", type: "other_explanation", level: "L6", header: "Other explanation", text: "China's services deficit, mostly travel, genuinely reduces its surplus", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#R1", name: "R1  Other explanation", doc: "setser_2025-07-28_china-eu-trade-war", nid: "R1", date: "2025-07-28", family: "meta", type: "other_explanation", level: "L6", header: "Other explanation", text: "China's long-standing tariff walls (25 percent on autos) also helped build the sector", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#R1", name: "R1  Other explanation", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "R1", date: "2025-09-12", family: "meta", type: "other_explanation", level: "L6", header: "Other explanation", text: "Waiting for tariff relief (autos) replaces front-running; other exporters can take U.S. market share abroad", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#R1", name: "R1  Other explanation", doc: "setser_2025-11-12_china-surplus-imf", nid: "R1", date: "2025-11-12", family: "meta", type: "other_explanation", level: "L6", header: "Other explanation", text: "Ireland distorts European data; IMF forecast misses come from ignoring lagged exchange rate effects and treating the pandemic surge as temporary", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#R1", name: "R1  Other explanation", doc: "setser_2026-02-03_october-2025-deficit", nid: "R1", date: "2026-02-03", family: "meta", type: "other_explanation", level: "L6", header: "Other explanation", text: "Auto imports fell along with auto sales: weaker demand rather than more U.S. production", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:OtherExplanation {uid: c.uid}) SET n += c;

// 1 x policy_reductio
UNWIND [{uid: "setser_mar_10_24#C3", name: "C3  Policy reductio", doc: "setser_mar_10_24", nid: "C3", date: "2024-03-10", family: "banner", type: "policy_reductio", level: "L4", header: "Policy reductio", text: "Take the IMF's own advice — consolidate 7.5pp of GDP, cut rates, loosen the currency — run it through IMF-derived econometrics, and the current account rises about 4pp of China's GDP. The cure enlarges the disease.", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:PolicyReductio {uid: c.uid}) SET n += c;

// 1 x position_map
UNWIND [{uid: "setser_may_5_25#POS", name: "POS  Position map", doc: "setser_may_5_25", nid: "POS", date: "2025-05-05", family: "banner", type: "position_map", level: "L0", header: "Position map", text: "Bessent at roughly 4% appreciation per 10% of tariffs; Miran expecting a rise; Lerner symmetry in the textbooks; going long the dollar as the standard post-election trade", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:PositionMap {uid: c.uid}) SET n += c;

// 20 x question
UNWIND [{uid: "setser_dec_15_17#Q", name: "Q  Why does the U.S. trade balance still…", doc: "setser_dec_15_17", nid: "Q", date: "2017-12-15", family: "plain", type: "question", level: "L0", header: "Why does the U.S. trade balance still matter,\neven if deficits can accompany strong growth?", text: "Why does the U.S. trade balance still matter,\neven if deficits can accompany strong growth?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#Q", name: "Q  Will Trump's fiscal expansion undermine his…", doc: "setser_feb_15_18", nid: "Q", date: "2018-02-15", family: "plain", type: "question", level: "L0", header: "Will Trump's fiscal expansion undermine\nhis goal of reducing the U.S. trade deficit?", text: "Will Trump's fiscal expansion undermine\nhis goal of reducing the U.S. trade deficit?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#Q", name: "Q  Could global macro shocks overwhelm trade…", doc: "setser_jun_4_18", nid: "Q", date: "2018-06-04", family: "plain", type: "question", level: "L0", header: "Could global macro shocks overwhelm trade deals\nand push the U.S. trade deficit higher?", text: "Could global macro shocks overwhelm trade deals\nand push the U.S. trade deficit higher?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#Q", name: "Q  If U.S.-China trade tensions escalate, will…", doc: "setser_may_2_19", nid: "Q", date: "2019-05-02", family: "plain", type: "question", level: "L0", header: "If U.S.-China trade tensions escalate,\nwill China keep the yuan stable or let it weaken?", text: "If U.S.-China trade tensions escalate,\nwill China keep the yuan stable or let it weaken?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#Q", name: "Q  If U.S.-China trade tensions escalate, will…", doc: "setser_may_10_19", nid: "Q", date: "2019-05-10", family: "plain", type: "question", level: "L0", header: "If U.S.-China trade tensions escalate,\nwill China keep the yuan stable or let it weaken?", text: "If U.S.-China trade tensions escalate,\nwill China keep the yuan stable or let it weaken?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#Q", name: "Q  Why did China's tariffs devastate some U.S.…", doc: "setser_jun_14_19", nid: "Q", date: "2019-06-14", family: "plain", type: "question", level: "L0", header: "Why did China's tariffs devastate some U.S. exports\nbut have limited effects on others?", text: "Why did China's tariffs devastate some U.S. exports\nbut have limited effects on others?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#Q", name: "Q  Why do the U.S., Europe, and China now…", doc: "setser_aug_13_19", nid: "Q", date: "2019-08-13", family: "plain", type: "question", level: "L0", header: "Why do the U.S., Europe, and China now occupy\nsuch different positions in manufacturing trade?", text: "Why do the U.S., Europe, and China now occupy\nsuch different positions in manufacturing trade?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#Q", name: "Q  Why do global trade imbalances persist, and…", doc: "setser_sep_20_19", nid: "Q", date: "2019-09-20", family: "plain", type: "question", level: "L0", header: "Why do global trade imbalances persist,\nand why could they worsen before improving?", text: "Why do global trade imbalances persist,\nand why could they worsen before improving?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#Q", name: "Q  Question", doc: "setser_jan_31_20", nid: "Q", date: "2020-01-31", family: "banner", type: "question", level: "L0", header: "Question", text: "How did China choose to respond to tariff pressure, and what does that reveal about managed trade?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#Q", name: "Q  Do tariffs change the trade balance, and who…", doc: "setser_feb_26_20", nid: "Q", date: "2020-02-26", family: "plain", type: "question", level: "L0", header: "Do tariffs change the trade balance,\nand who absorbed the Q4 US demand drop?", text: "Do tariffs change the trade balance,\nand who absorbed the Q4 US demand drop?", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#Q", name: "Q  Question", doc: "setser_mar_31_20", nid: "Q", date: "2020-03-31", family: "banner", type: "question", level: "L0", header: "Question", text: "Emerging economies face the same shocks — do they need the same response?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#Q", name: "Q  Question", doc: "setser_jul_8_20", nid: "Q", date: "2020-07-08", family: "banner", type: "question", level: "L0", header: "Question", text: "Is China on track to meet its Phase One purchase commitments?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#Q", name: "Q  Question", doc: "setser_mar_10_24", nid: "Q", date: "2024-03-10", family: "banner", type: "question", level: "L0", header: "Question", text: "Is China's centrality to global manufacturing really declining, as the fragmentation narrative suggests?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#Q", name: "Q  Question", doc: "setser_aug_14_24", nid: "Q", date: "2024-08-14", family: "banner", type: "question", level: "L0", header: "Question", text: "Why does the reported current account diverge from the customs surplus, and which is right?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#Q", name: "Q  Question", doc: "setser_may_5_25", nid: "Q", date: "2025-05-05", family: "banner", type: "question", level: "L0", header: "Question", text: "Why didn't tariffs push up the dollar?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#Q", name: "Q  Question", doc: "setser_2025-07-07_china-stealth-surplus", nid: "Q", date: "2025-07-07", family: "meta", type: "question", level: "L0", header: "Question", text: "Why does China's surplus look small in IMF imbalance data when trade flows show it is huge?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#Q", name: "Q  Question", doc: "setser_2025-07-28_china-eu-trade-war", nid: "Q", date: "2025-07-28", family: "meta", type: "question", level: "L0", header: "Question", text: "Why is Europe losing ground to China in trade, and what should it do about it?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#Q", name: "Q  Question", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "Q", date: "2025-09-12", family: "meta", type: "question", level: "L0", header: "Question", text: "Have Trump's tariffs actually shocked trade flows and the global economy?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#Q", name: "Q  Question", doc: "setser_2025-11-12_china-surplus-imf", nid: "Q", date: "2025-11-12", family: "meta", type: "question", level: "L0", header: "Question", text: "How big is China's surplus really, why does the IMF miss it, and what policy should follow?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#Q", name: "Q  Question", doc: "setser_2026-02-03_october-2025-deficit", nid: "Q", date: "2026-02-03", family: "meta", type: "question", level: "L0", header: "Question", text: "Does the low October 2025 trade deficit mean the tariffs are working?", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:Question {uid: c.uid}) SET n += c;

// 3 x recommendation
UNWIND [{uid: "setser_mar_31_20#REC", name: "REC  Recommendation", doc: "setser_mar_31_20", nid: "REC", date: "2020-03-31", family: "banner", type: "recommendation", level: "L5", header: "Recommendation", text: "Draw down buffers; central bank backstop plus swap lines; mobilise trade finance; SDR allocation, larger IMF capacity, MDB callable capital, payment deferral", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#REC", name: "REC  Recommendation", doc: "setser_mar_10_24", nid: "REC", date: "2024-03-10", family: "banner", type: "recommendation", level: "L5", header: "Recommendation", text: "The size of the imbalance, correctly measured, must be factored into Chinese policymaking and into external policy advice", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#REC", name: "REC  Recommendation", doc: "setser_aug_14_24", nid: "REC", date: "2024-08-14", family: "banner", type: "recommendation", level: "L5", header: "Recommendation", text: "implied only — stop using the reported series", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: true, concept: ""}] AS c
MERGE (n:Claim:Recommendation {uid: c.uid}) SET n += c;

// 1 x reconstruction
UNWIND [{uid: "setser_aug_14_24#RC", name: "RC  Reconstruction", doc: "setser_aug_14_24", nid: "RC", date: "2024-08-14", family: "banner", type: "reconstruction", level: "L5", header: "Reconstruction", text: "Goods surplus understated by ~$300bn, over 1.5pp of GDP; true current account surplus close to $700bn — use the customs data", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:Reconstruction {uid: c.uid}) SET n += c;

// 3 x revised_prior
UNWIND [{uid: "setser_jan_31_20#P3", name: "P3  Revised prior", doc: "setser_jan_31_20", nid: "P3", date: "2020-01-31", family: "banner", type: "revised_prior", level: "L1", header: "Revised prior", text: "\"I was surprised by the size of China's impact... I thought U.S. soy would prove to be more of a pure commodity\" — and \"I don't think many expected\" reserves to stay stable", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#P3", name: "P3  Revised prior", doc: "setser_mar_31_20", nid: "P3", date: "2020-03-31", family: "banner", type: "revised_prior", level: "L1", header: "Revised prior", text: "\"contrary to a forecast that I made with Dr. Roubini back in 2005\" — private credit intermediation broke down before central banks lost their appetite for intervention", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#P3", name: "P3  Revised prior", doc: "setser_may_5_25", nid: "P3", date: "2025-05-05", family: "banner", type: "revised_prior", level: "L1", header: "Revised prior", text: "\"the dollar's downturn was still a bit of a surprise\" — he counts himself among those caught out", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:RevisedPrior {uid: c.uid}) SET n += c;

// 2 x scope_choice
UNWIND [{uid: "setser_jul_8_20#SCP", name: "SCP  Scope choice", doc: "setser_jul_8_20", nid: "SCP", date: "2020-07-08", family: "banner", type: "scope_choice", level: "L1B", header: "Scope choice", text: "Services excluded because in-China sales are not exports; aircraft adjusted out; only the listed HS codes counted", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#SCP", name: "SCP  Scope choice", doc: "setser_mar_10_24", nid: "SCP", date: "2024-03-10", family: "banner", type: "scope_choice", level: "L1B", header: "Scope choice", text: "SITC categories 5 through 9, the standard manufactures breakout, from the long UN Comtrade series", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:ScopeChoice {uid: c.uid}) SET n += c;

// 3 x source_credibility
UNWIND [{uid: "setser_jan_31_20#SC", name: "SC  Source credibility", doc: "setser_jan_31_20", nid: "SC", date: "2020-01-31", family: "banner", type: "source_credibility", level: "L1", header: "Source credibility", text: "\"Chinese data never quite fully lines up, which bothers me more than most\"", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_10_24#SC", name: "SC  Source credibility", doc: "setser_mar_10_24", nid: "SC", date: "2024-03-10", family: "banner", type: "source_credibility", level: "L1", header: "Source credibility", text: "The reported current account \"misleads\" — flagged, with the full case made in the August companion piece", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#SC", name: "SC  Source credibility", doc: "setser_aug_14_24", nid: "SC", date: "2024-08-14", family: "banner", type: "source_credibility", level: "L1", header: "Source credibility", text: "The methodology was already changed at a convenient moment in 2015, and backdated", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:SourceCredibility {uid: c.uid}) SET n += c;

// 43 x stated_assumption
UNWIND [{uid: "setser_dec_15_17#P1", name: "P1  Net exports contribute to GDP growth", doc: "setser_dec_15_17", nid: "P1", date: "2017-12-15", family: "plain", type: "stated_assumption", level: "L1", header: "Net exports contribute to GDP growth", text: "Changes in exports and imports mechanically affect output growth", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#P2", name: "P2  Trade shapes employment composition", doc: "setser_dec_15_17", nid: "P2", date: "2017-12-15", family: "plain", type: "stated_assumption", level: "L1", header: "Trade shapes employment composition", text: "Goods-producing sectors and regions are unevenly exposed", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#P3", name: "P3  Persistent deficits accumulate external debt", doc: "setser_dec_15_17", nid: "P3", date: "2017-12-15", family: "plain", type: "stated_assumption", level: "L1", header: "Persistent deficits accumulate external debt", text: "Ongoing borrowing raises the net external debt stock", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "deficits-require-financing"},
  {uid: "setser_feb_15_18#P1", name: "P1  Fiscal stimulus raises domestic demand", doc: "setser_feb_15_18", nid: "P1", date: "2018-02-15", family: "plain", type: "stated_assumption", level: "L1", header: "Fiscal stimulus raises domestic demand", text: "Tax cuts and spending increases boost U.S. demand", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#P2", name: "P2  Imports respond strongly to U.S. demand", doc: "setser_feb_15_18", nid: "P2", date: "2018-02-15", family: "plain", type: "stated_assumption", level: "L1", header: "Imports respond strongly to U.S. demand", text: "Fed model: import income elasticity around 2", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#P3", name: "P3  Exchange-rate effects arrive with lags", doc: "setser_feb_15_18", nid: "P3", date: "2018-02-15", family: "plain", type: "stated_assumption", level: "L1", header: "Exchange-rate effects arrive with lags", text: "Dollar moves take years to fully affect trade", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#P1", name: "P1  Trade balances are macroeconomic", doc: "setser_jun_4_18", nid: "P1", date: "2018-06-04", family: "plain", type: "stated_assumption", level: "L1", header: "Trade balances are macroeconomic", text: "They reflect demand, fiscal policy, currencies, and external adjustment—not just trade deals", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#P2", name: "P2  U.S. fiscal stimulus needs foreign demand", doc: "setser_jun_4_18", nid: "P2", date: "2018-06-04", family: "plain", type: "stated_assumption", level: "L1", header: "U.S. fiscal stimulus needs foreign demand", text: "The deficit rises unless stronger U.S. demand is matched abroad", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_4_18#P3", name: "P3  Weak demand encourages export-led adjustment", doc: "setser_jun_4_18", nid: "P3", date: "2018-06-04", family: "plain", type: "stated_assumption", level: "L1", header: "Weak demand encourages export-led adjustment", text: "Countries under pressure often rely on weaker currencies and exports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#P1", name: "P1  China controls the yuan", doc: "setser_may_2_19", nid: "P1", date: "2019-05-02", family: "plain", type: "stated_assumption", level: "L1", header: "China controls the yuan", text: "Reserves, capital controls, and policy tools give Beijing substantial exchange-rate control", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#P2", name: "P2  Depreciation offsets tariffs", doc: "setser_may_2_19", nid: "P2", date: "2019-05-02", family: "plain", type: "stated_assumption", level: "L1", header: "Depreciation offsets tariffs", text: "A weaker yuan lets exporters lower dollar prices while preserving yuan revenue", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_2_19#P3", name: "P3  Stability has value", doc: "setser_may_2_19", nid: "P3", date: "2019-05-02", family: "plain", type: "stated_assumption", level: "L1", header: "Stability has value", text: "A stable currency supports confidence and reduces financial risk", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#P1", name: "P1  China controls the yuan", doc: "setser_may_10_19", nid: "P1", date: "2019-05-10", family: "plain", type: "stated_assumption", level: "L1", header: "China controls the yuan", text: "Reserves, capital controls, and policy tools give Beijing substantial exchange-rate control", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#P2", name: "P2  Depreciation offsets tariffs", doc: "setser_may_10_19", nid: "P2", date: "2019-05-10", family: "plain", type: "stated_assumption", level: "L1", header: "Depreciation offsets tariffs", text: "A weaker yuan lets exporters lower dollar prices while preserving yuan revenue", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_10_19#P3", name: "P3  Stability has value", doc: "setser_may_10_19", nid: "P3", date: "2019-05-10", family: "plain", type: "stated_assumption", level: "L1", header: "Stability has value", text: "A stable currency supports confidence and reduces financial risk", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#P1", name: "P1  Tariff effects are sector-specific", doc: "setser_jun_14_19", nid: "P1", date: "2019-06-14", family: "plain", type: "stated_assumption", level: "L1", header: "Tariff effects are sector-specific", text: "Substitution and market structure determine the aggregate impact", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#P2", name: "P2  Bilateral trade ≠ total trade", doc: "setser_jun_14_19", nid: "P2", date: "2019-06-14", family: "plain", type: "stated_assumption", level: "L1", header: "Bilateral trade ≠ total trade", text: "Lost sales to China may be redirected elsewhere", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jun_14_19#P3", name: "P3  Retaliation requires viable substitutes", doc: "setser_jun_14_19", nid: "P3", date: "2019-06-14", family: "plain", type: "stated_assumption", level: "L1", header: "Retaliation requires viable substitutes", text: "China cannot easily stop buying essential imports", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#P1", name: "P1  Trade shares reveal production structure", doc: "setser_aug_13_19", nid: "P1", date: "2019-08-13", family: "plain", type: "stated_assumption", level: "L1", header: "Trade shares reveal production structure", text: "Exports and imports relative to GDP show how economies engage globally", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#P2", name: "P2  Manufacturing balances reflect where…", doc: "setser_aug_13_19", nid: "P2", date: "2019-08-13", family: "plain", type: "stated_assumption", level: "L1", header: "Manufacturing balances reflect where production occurs", text: "Not simply how open an economy is", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_13_19#P3", name: "P3  Persistent deficits require financing", doc: "setser_aug_13_19", nid: "P3", date: "2019-08-13", family: "plain", type: "stated_assumption", level: "L1", header: "Persistent deficits require financing", text: "Import bills must ultimately be covered by income or borrowing", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "deficits-require-financing"},
  {uid: "setser_sep_20_19#P1", name: "P1  Global surpluses require matching deficits", doc: "setser_sep_20_19", nid: "P1", date: "2019-09-20", family: "plain", type: "stated_assumption", level: "L1", header: "Global surpluses require matching deficits", text: "If large economies save externally, another economy must absorb the surplus", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#P2", name: "P2  Fiscal policy shapes external balances", doc: "setser_sep_20_19", nid: "P2", date: "2019-09-20", family: "plain", type: "stated_assumption", level: "L1", header: "Fiscal policy shapes external balances", text: "Weak domestic demand tends to reduce imports and raise surpluses", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_sep_20_19#P3", name: "P3  Excess saving generates surplus pressure", doc: "setser_sep_20_19", nid: "P3", date: "2019-09-20", family: "plain", type: "stated_assumption", level: "L1", header: "Excess saving generates surplus pressure", text: "Saving above domestic investment pushes capital and demand abroad", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jan_31_20#P1", name: "P1  Stated assumption", doc: "setser_jan_31_20", nid: "P1", date: "2020-01-31", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Industrial policy is non-negotiable; the state can direct commodity purchases", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "state-can-direct-purchases"},
  {uid: "setser_feb_26_20#P2", name: "P2  Tariff revenue is not offset", doc: "setser_feb_26_20", nid: "P2", date: "2020-02-26", family: "plain", type: "stated_assumption", level: "L1", header: "Tariff revenue is not offset", text: "Trade scholars assume it is; Setser says not necessarily", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#P3", name: "P3  Few substitutes for China goods", doc: "setser_feb_26_20", nid: "P3", date: "2020-02-26", family: "plain", type: "stated_assumption", level: "L1", header: "Few substitutes for China goods", text: "So the tariffs work as a clear tax", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_26_20#P4", name: "P4  Tariff uncertainty weighs on firms", doc: "setser_feb_26_20", nid: "P4", date: "2020-02-26", family: "plain", type: "stated_assumption", level: "L1", header: "Tariff uncertainty weighs on firms", text: "Uncertainty can reduce investment", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_mar_31_20#P1", name: "P1  Stated assumption", doc: "setser_mar_31_20", nid: "P1", date: "2020-03-31", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Shocks can offset one another; swap lines fund dollar balance sheets, not balance-of-payments gaps", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_jul_8_20#P1", name: "P1  Stated assumption", doc: "setser_jul_8_20", nid: "P1", date: "2020-07-08", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Agriculture and energy flow through a few state firms, so purchases can be directed; manufacturing cannot", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "state-can-direct-purchases"},
  {uid: "setser_mar_10_24#P1", name: "P1  Stated assumption", doc: "setser_mar_10_24", nid: "P1", date: "2024-03-10", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Bilateral data misleads about global position — rerouting is not displacement", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_aug_14_24#P1", name: "P1  Stated assumption", doc: "setser_aug_14_24", nid: "P1", date: "2024-08-14", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "The balance-of-payments surplus should exceed customs; a methodology change should net out", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_may_5_25#P1", name: "P1  Stated assumption", doc: "setser_may_5_25", nid: "P1", date: "2025-05-05", family: "banner", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Lerner symmetry holds — a tax on imports is a tax on exports, even without retaliation", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#P1", name: "P1  Stated assumption", doc: "setser_2025-07-07_china-stealth-surplus", nid: "P1", date: "2025-07-07", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "A large real estate crisis typically pushes a country to rely more on exports (standard economic theory)", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-07_china-stealth-surplus#P2", name: "P2  Stated assumption", doc: "setser_2025-07-07_china-stealth-surplus", nid: "P2", date: "2025-07-07", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Customs goods data captures China's real imbalance better than balance of payments data", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-07-28_china-eu-trade-war#P1", name: "P1  Stated assumption", doc: "setser_2025-07-28_china-eu-trade-war", nid: "P1", date: "2025-07-28", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "China's trade war tools are industrial policy and a weak currency, not tariffs", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "state-can-direct-purchases"},
  {uid: "setser_2025-07-28_china-eu-trade-war#P2", name: "P2  Stated assumption", doc: "setser_2025-07-28_china-eu-trade-war", nid: "P2", date: "2025-07-28", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Chinese firms, private or state-linked, accept low returns on equity and build too much", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#P1", name: "P1  Stated assumption", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "P1", date: "2025-09-12", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "A global tariff works like an exchange rate move: import elasticity of about 0.3 to 0.4, not the bilateral elasticity of about 2", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-09-12_trump-shock-that-wasnt#P2", name: "P2  Stated assumption", doc: "setser_2025-09-12_trump-shock-that-wasnt", nid: "P2", date: "2025-09-12", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Record tariff revenue means Americans keep importing and paying the tariff", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#P1", name: "P1  Stated assumption", doc: "setser_2025-11-12_china-surplus-imf", nid: "P1", date: "2025-11-12", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "The surplus stems from a shortfall in China's domestic demand (European Central Bank view)", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2025-11-12_china-surplus-imf#P2", name: "P2  Stated assumption", doc: "setser_2025-11-12_china-surplus-imf", nid: "P2", date: "2025-11-12", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Deflation combined with a rising trade surplus calls for sustained fiscal expansion, not monetary easing", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#P1", name: "P1  Stated assumption", doc: "setser_2026-02-03_october-2025-deficit", nid: "P1", date: "2026-02-03", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Tariffs reduce the trade deficit only if their proceeds reduce the budget deficit, acting as a tax hike", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_2026-02-03_october-2025-deficit#P2", name: "P2  Stated assumption", doc: "setser_2026-02-03_october-2025-deficit", nid: "P2", date: "2026-02-03", family: "meta", type: "stated_assumption", level: "L1", header: "Stated assumption", text: "Remove pharmaceuticals and gold to read the underlying deficit", type_source: "header", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""}] AS c
MERGE (n:Claim:StatedAssumption {uid: c.uid}) SET n += c;

// ---- claim -> document ----
MATCH (c:Claim), (d:Document) WHERE c.doc = d.id MERGE (c)-[:IN]->(d);

// ---- claim -> concept ----
MATCH (c:Claim), (k:Concept) WHERE c.concept = k.id
MERGE (c)-[:INSTANCE_OF]->(k);

