  {uid: "setser_dec_15_17#D3", name: "D3  Manufacturing balance did not drive adjustment", doc: "setser_dec_15_17", nid: "D3", date: "2017-12-15", family: "plain", type: "evidence_data", level: "L2", header: "Manufacturing balance did not drive adjustment", text: "Lower oil imports and offshore income reduced the current-account deficit", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#D4", name: "D4  External debt rose from ~20% to ~50% of GDP", doc: "setser_dec_15_17", nid: "D4", date: "2017-12-15", family: "plain", type: "evidence_data", level: "L2", header: "External debt rose from ~20% to ~50% of GDP", text: "Debt increased even as U.S. borrowing costs fell", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_dec_15_17#D5", name: "D5  Higher rates or wider deficits raise debt…", doc: "setser_dec_15_17", nid: "D5", date: "2017-12-15", family: "plain", type: "evidence_data", level: "L2", header: "Higher rates or wider deficits raise debt ratios", text: "Either would weaken current favorable debt dynamics", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "debt-dynamics-sensitive-to-rates"},
  {uid: "setser_dec_15_17#D6", name: "D6  Tax cuts could widen trade deficit", doc: "setser_dec_15_17", nid: "D6", date: "2017-12-15", family: "plain", type: "evidence_data", level: "L2", header: "Tax cuts could widen trade deficit", text: "Setser estimates roughly 0.3–0.5% of GDP over several years", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#D1", name: "D1  Fiscal deficit +1.7–2% of GDP", doc: "setser_feb_15_18", nid: "D1", date: "2018-02-15", family: "plain", type: "evidence_data", level: "L2", header: "Fiscal deficit +1.7–2% of GDP", text: "Tax cuts and spending increases provide a large fiscal impulse", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#D2", name: "D2  IMF external-balance coefficient", doc: "setser_feb_15_18", nid: "D2", date: "2018-02-15", family: "plain", type: "evidence_data", level: "L2", header: "IMF external-balance coefficient", text: "Simple model implies current-account deficit rises about 1% of GDP", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#D3", name: "D3  Q4 2017 demand surge leaked into imports", doc: "setser_feb_15_18", nid: "D3", date: "2018-02-15", family: "plain", type: "evidence_data", level: "L2", header: "Q4 2017 demand surge leaked into imports", text: "Over half of the increase in domestic demand was spent abroad", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
  {uid: "setser_feb_15_18#D4", name: "D4  U.S. external debt ≈ 50% of GDP", doc: "setser_feb_15_18", nid: "D4", date: "2018-02-15", family: "plain", type: "evidence_data", level: "L2", header: "U.S. external debt ≈ 50% of GDP", text: "Higher rates mechanically increase payments to foreign creditors", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: "debt-dynamics-sensitive-to-rates"},
  {uid: "setser_feb_15_18#D5", name: "D5  Foreign currencies strengthening", doc: "setser_feb_15_18", nid: "D5", date: "2018-02-15", family: "plain", type: "evidence_data", level: "L2", header: "Foreign currencies strengthening", text: "Euro and several Asian currencies were moving against the dollar", type_source: "class", claim_type: "", mechanism_kind: "", implicit_only: false, concept: ""},
