UNWIND [{id: "state-can-direct-purchases", name: "Industrial policy is the lever, and the state can direct trade flows", label: "Industrial policy is the lever, and the state can direct trade flows", note: "A prior Setser returns to across five years: because a few state firms control agriculture and energy, purchase commitments are achievable, while manufacturing is not directable the same way."},
  {id: "bop-understates-china-surplus", name: "Balance-of-payments methodology understates China's true surplus", label: "Balance-of-payments methodology understates China's true surplus", note: "The mechanism behind the 2024-2025 measurement critiques - an unexplained series break plus an unexplained income deficit, both shrinking the reported current account relative to customs data."},
  {id: "deficits-require-financing", name: "Persistent deficits must ultimately be financed", label: "Persistent deficits must ultimately be financed", note: "The accounting prior under the 2017-2019 posts; later maps assume it rather than stating it."},
  {id: "debt-dynamics-sensitive-to-rates", name: "Favourable external debt dynamics depend on rates staying low", label: "Favourable external debt dynamics depend on rates staying low", note: ""}] AS c
