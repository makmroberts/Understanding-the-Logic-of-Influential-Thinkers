# Extracted source text and HTML caches stay local - only the scripts that
# produce them are versioned. See scripts/README.md.
internal/

# Secrets. Never commit these - an API key in git history stays in git history
# even after a later deletion, and has to be rotated rather than removed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node, if we add Quartz or similar later
node_modules/

# OS
.DS_Store
Thumbs.db

# Obsidian per-user UI state - which panes are open, window size. Churns on
# every session and is personal. The vault's graph.json colour groups ARE
# versioned, since those are part of how the maps are meant to be read.
obsidian/.obsidian/workspace.json
obsidian/.obsidian/workspace-mobile.json

# Vendored Obsidian community plugins - 2.3 MB of someone else's build. The
# vault needs Dataview for the query blocks in Cells.md; install it from
# Settings > Community plugins rather than cloning it. See PROCESS.md.
obsidian/.obsidian/plugins/

# Editor settings, per-person
.vscode/

# Working notes for the coding assistant, not project documentation. PROCESS.md
# is the explainer a person should read.
CLAUDE.md
