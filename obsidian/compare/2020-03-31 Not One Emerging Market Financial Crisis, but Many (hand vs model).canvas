  },
  {
   "id": "h-E2-REC",
   "fromNode": "hand-E2",
   "fromSide": "bottom",
   "toNode": "hand-REC",
   "toSide": "top",
   "color": "4",
   "label": "+1 supports"
  },
  {
   "id": "h-C2-REC",
   "fromNode": "hand-C2",
   "fromSide": "bottom",
   "toNode": "hand-REC",
   "toSide": "top",
   "color": "4",
   "label": "+1 supports"
  },
