   "color": "4",
   "label": "+1 supports"
  },
  {
   "id": "h-D1-M1",
   "fromNode": "hand-D1",
   "fromSide": "bottom",
   "toNode": "hand-M1",
   "toSide": "top",
   "color": "4",
   "label": "+1 supports"
  },
  {
   "id": "h-D6-M1",
   "fromNode": "hand-D6",
   "fromSide": "bottom",
   "toNode": "hand-M1",
