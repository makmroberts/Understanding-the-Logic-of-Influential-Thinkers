  },
  {
   "id": "h-C1-K",
   "fromNode": "hand-C1",
   "fromSide": "bottom",
   "toNode": "hand-K",
   "toSide": "top",
   "color": "4",
   "label": "+1 supports"
  },
  {
   "id": "h-K-X",
   "fromNode": "hand-K",
   "fromSide": "bottom",
   "toNode": "hand-X",
   "toSide": "top",
   "color": "1",
   "label": "-1 rebuts"
  },
  {
   "id": "h-K-QF",
   "fromNode": "hand-K",
   "fromSide": "bottom",
   "toNode": "hand-QF",
   "toSide": "top",
   "color": "1",
   "label": "-1 qualified_by"
