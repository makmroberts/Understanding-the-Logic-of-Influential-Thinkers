 "summary": {
  "central_question": "Why has China's balance of payments goods surplus diverged so sharply from its customs goods surplus since 2022, and which measure should be trusted?",
  "main_thesis": "The reported fall in China's surplus is a statistical artifact; customs data, which show a near-peak goods surplus, tell the true story.",
  "argument_summary": null
 },
