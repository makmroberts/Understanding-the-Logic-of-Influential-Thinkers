   "legacy_id": "E2",
   "role": "evidence_source",
   "level": "L2",
   "content": {
    "text": "In 2022 China switched its balance of payments goods source from customs data to an internal survey of about 13,000 large enterprises, so no outsider can replicate it.",
    "label": null,
    "explicit": true,
    "reason": "A statistic built from unpublished surveys cannot be independently checked."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p1",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
      "review_status": "pending",
      "source_excerpt": null
