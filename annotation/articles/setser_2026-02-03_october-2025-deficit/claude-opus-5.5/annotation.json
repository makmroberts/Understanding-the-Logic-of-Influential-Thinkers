  },
  {
   "id": "n003",
   "legacy_id": "M1",
   "role": "mechanism",
   "level": "L3",
   "content": {
    "text": "Fear of tariffs led importers to front-load pharmaceuticals and gold, then imports fell back once the tariffs did not come.",
    "label": null,
    "explicit": true,
    "reason": "Anticipated tariffs pull imports forward, and the reversal later shows up as an artificial fall."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p4",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Fear of a pharmaceutical tariff led to large imports of pharmaceuticals in February and March 2025, ahead of the Liberation Day tariff rollout."
     },
     {
      "paragraph_id": "p5",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
      "review_status": "pending",
      "source_excerpt": null
     },
     {
      "paragraph_id": "p6",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
      "review_status": "pending",
