  {
   "id": "n017",
   "legacy_id": "P2",
   "role": "stated_assumption",
   "level": "L1",
   "content": {
    "text": "Tariffs shrink the trade deficit only if their revenue reduces the budget deficit, so that they work like a tax hike.",
    "label": null,
    "explicit": true,
    "reason": "The external balance equals national saving minus investment, so it shifts only if saving rises."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p16",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Economic theory suggests that tariffs can reduce the trade deficit if their proceeds are used to reduce the budget deficit."
     }
    ]
