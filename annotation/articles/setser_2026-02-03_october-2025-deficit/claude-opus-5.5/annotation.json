  {
   "id": "n004",
   "legacy_id": "P3",
   "role": "hidden_assumption",
   "level": "L1",
   "content": {
    "text": "Gold flows reflect financial positioning, not real demand, so they should be stripped out when judging the underlying trade balance.",
    "label": null,
    "explicit": false,
    "reason": "Volatile, non-economic flows distort headline trade data and should be excluded from the core measure."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p6",
      "relation": "presupposes",
      "link_method": "llm_citation",
