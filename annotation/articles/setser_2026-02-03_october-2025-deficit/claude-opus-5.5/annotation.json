  {
   "id": "n003",
   "legacy_id": "M1",
   "role": "mechanism",
   "level": "L3",
   "content": {
    "text": "Fear of tariffs that never came caused front-loaded surges in pharmaceutical and gold imports, followed by declines once the threat faded and stockpiles were in place.",
    "label": null,
    "explicit": true,
    "reason": "Anticipated tariffs pull imports forward, and imports then fall back as stockpiles are drawn down."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p4",
      "paragraph_sha256": "sha256:5a00029b773b9bfbffcc09dcc32af90a7466f904c844928dc8c0bad144307ae9",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Fear of a sectoral pharmaceutical tariff led to a similar surge in pharmaceutical imports in September 2025.",
      "source_spans": [
       {
        "char_start": 144,
        "char_end": 252
       }
      ]
     },
     {
      "paragraph_id": "p5",
      "paragraph_sha256": "sha256:4787ff819af6426b3cd55fed4216319c2facbd9a20f30965961b7af3a870810f",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
