  {
   "id": "n008",
   "legacy_id": "E2",
   "role": "evidence_data",
   "level": "L2",
   "content": {
    "text": "Deficits in early 2025 were much larger than in early 2024, which shows imports were pulled forward into inventories.",
    "label": null,
    "explicit": true,
    "reason": "Earlier excess imports signal inventory building that later depresses imports."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p11",
      "paragraph_sha256": "sha256:c540f884989d25791132dfbaf6ff2fdd713935b6f4848476bec7f84c42a84126",
