  {
   "id": "n008",
   "legacy_id": "C2",
   "role": "intermediate_claim",
   "level": "L4",
   "content": {
    "text": "Part of the recent fall reflects running down stockpiles built before the tariffs, so it is temporary.",
    "label": null,
    "explicit": true,
    "reason": "An import dip driven by drawing down inventories reverses once those inventories are used up."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p11",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Thus, the dip in imports will not last that much longer; stockpiles do run out."
     }
    ]
   },
   "facets": {
    "variable": [
     {
      "term": "inventories",
      "assignment_source": "llm",
      "run_id": "claude-opus-5.5_facets"
     },
     {
      "term": "import-volumes",
      "assignment_source": "llm",
      "run_id": "claude-opus-5.5_facets"
     }
    ],
    "country": [
     {
      "term": "us",
      "assignment_source": "llm",
      "run_id": "claude-opus-5.5_facets",
      "geo_role": "subject"
     }
    ],
    "bloc": [],
    "instrument": [],
    "data_basis": []
   },
   "attributes": {},
   "provenance": {
    "method": "llm",
    "run_id": "claude-opus-5.5_boxes"
   },
   "review": {
    "status": "pending",
    "reasons": []
   }
  },
  {
   "id": "n009",
   "legacy_id": "P1",
   "role": "stated_assumption",
   "level": "L1",
   "content": {
    "text": "Inventories are finite, so imports return once stockpiles are exhausted.",
    "label": null,
    "explicit": true,
    "reason": "Stockpiling only shifts the timing of demand; it does not eliminate it."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p11",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "stockpiles do run out"
     },
     {
      "paragraph_id": "p16",
      "relation": "abstracts",
      "link_method": "llm_citation",
