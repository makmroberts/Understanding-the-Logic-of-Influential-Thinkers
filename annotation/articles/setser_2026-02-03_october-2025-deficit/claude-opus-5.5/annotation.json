  {
   "id": "n009",
   "legacy_id": "C3",
   "role": "intermediate_claim",
   "level": "L4",
   "content": {
    "text": "Part of the recent dip reflects drawdowns of stockpiles and will be temporary.",
    "label": null,
    "explicit": true,
    "reason": "Inventory drawdowns are finite, so import declines driven by them reverse."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p11",
