  {
   "id": "n014",
   "legacy_id": "E4",
   "role": "evidence_source",
   "level": "L2",
   "content": {
    "text": "The semiconductor 232 investigation largely exempts chips imported for domestic use from future tariffs.",
    "label": null,
    "explicit": true,
    "reason": "The scope of official trade measures determines which import flows can respond to them."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p14",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "The 232 sectoral investigation into semiconductors—which was just released—more or less excludes semiconductors imported for domestic use from any tariffs going forward."
     }
    ]
   },
