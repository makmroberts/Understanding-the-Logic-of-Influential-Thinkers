  {
   "id": "n014",
   "legacy_id": "K",
   "role": "main_claim",
   "level": "L5",
   "content": {
    "text": "The 2025 deficit is unlikely to fall significantly: tariffs cut imports of the goods they target, but imports of untariffed pharmaceuticals, chips and computers are rising.",
    "label": null,
    "explicit": true,
    "reason": "Sector-specific tariffs shift the composition of imports without necessarily changing the overall balance."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p12",
      "paragraph_sha256": "sha256:9275a2d37ba6c84629fa8151566b4051082911e869685fb2f38b6f7f6d030779",
      "relation": "abstracts",
      "link_method": "llm_citation",
