  {
   "id": "n005",
   "legacy_id": "SCP",
   "role": "scope_choice",
   "level": "L1B",
   "content": {
    "text": "The author measures the deficit net of pharmaceuticals and gold to assess the effect of tariffs.",
    "label": null,
    "explicit": true,
    "reason": "Excluding categories dominated by one-off speculative flows gives a cleaner signal of policy effects."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p7",
      "paragraph_sha256": "sha256:922af0ef20003a395939559c4c44e09e93414d9dad2c5f4ba7fe7cf65a0ab1e7",
      "relation": "abstracts",
