  {
   "id": "n015",
   "legacy_id": "P1",
   "role": "stated_assumption",
   "level": "L1",
   "content": {
    "text": "Tariffs reduce the trade deficit only if their revenue tightens the fiscal balance.",
    "label": null,
    "explicit": true,
    "reason": "The external balance reflects national saving, so a lasting fall in the deficit requires fiscal tightening."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p16",
      "paragraph_sha256": "sha256:3bd79ffe3e9f9c8e52db629359840aa578d03ef11a88b4d1b8fbd620f50b0b47",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Economic theory suggests that tariffs can reduce the trade deficit if their proceeds are used to reduce the budget deficit. In that case, tariffs basically work as a tax hike.",
      "source_spans": [
       {
        "char_start": 162,
        "char_end": 337
       }
      ]
     }
    ]
   },
   "facets": {
    "variable": [
     {
