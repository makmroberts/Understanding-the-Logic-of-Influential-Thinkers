  {
   "id": "n013",
   "legacy_id": "M3",
   "role": "mechanism",
   "level": "L3",
   "content": {
    "text": "The AI data-center buildout, combined with the exemption of chips under the 232 review, drives electronics imports up.",
    "label": null,
    "explicit": true,
    "reason": "An investment boom raises imports of the capital goods it needs."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p14",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "And building the data centers to support the current boom in artificial intelligence has required importing a lot of electronics."
     }
    ]
   },
   "facets": {
