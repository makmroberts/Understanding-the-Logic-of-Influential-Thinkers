   "legacy_id": "C4",
   "role": "intermediate_claim",
   "level": "L4",
   "content": {
    "text": "Tariffs are reducing imports in the categories they target, largely by cutting consumption rather than raising domestic output.",
    "label": null,
    "explicit": true,
    "reason": "A price-raising tax lowers the quantity demanded of the taxed goods."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p13",
