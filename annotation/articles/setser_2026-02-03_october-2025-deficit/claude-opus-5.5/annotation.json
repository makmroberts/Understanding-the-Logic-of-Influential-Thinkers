  {
   "id": "n012",
   "legacy_id": "E3",
   "role": "evidence_data",
   "level": "L2",
   "content": {
    "text": "Imports of untariffed semiconductors and computers have risen sharply.",
    "label": null,
    "explicit": true,
    "reason": "Untaxed categories can grow fast enough to offset falls elsewhere."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p14",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "On the other hand, imports of semiconductors and computers are up substantially. Neither category has yet faced any real tariffs."
     }
    ]
   },
   "facets": {
    "variable": [
