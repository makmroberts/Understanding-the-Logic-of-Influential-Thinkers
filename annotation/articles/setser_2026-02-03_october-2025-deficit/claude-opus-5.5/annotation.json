   "legacy_id": "E3",
   "role": "evidence_data",
   "level": "L2",
   "content": {
    "text": "Imports of heavily tariffed autos and household durables are down even after adjusting for stockpiling, and domestic production has not replaced them.",
    "label": null,
    "explicit": true,
    "reason": "Compare tariffed with untariffed categories to isolate the tariff effect."
   },
   "source": {
    "passages": [
