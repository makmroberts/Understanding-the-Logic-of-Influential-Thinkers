  {
   "id": "n011",
   "legacy_id": "M2",
   "role": "mechanism",
   "level": "L3",
   "content": {
    "text": "Tariffs reduce imports in the categories they hit, but mainly by cutting consumption rather than raising domestic output.",
    "label": null,
    "explicit": true,
    "reason": "A tax on imports lowers demand for the taxed goods, which need not raise local production."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p13",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "So, the tariffs are affecting certain product categories."
     }
    ]
   },
