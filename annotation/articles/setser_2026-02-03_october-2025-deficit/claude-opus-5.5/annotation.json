   "legacy_id": "DF",
   "role": "deferred_question",
   "level": "L6",
   "content": {
    "text": "Whether imports rebound after stockpiles run out, and how much of the refund checks is spent on imports, remain open questions.",
    "label": null,
    "explicit": true,
    "reason": "Effects that depend on future inventory and spending behavior cannot yet be measured."
