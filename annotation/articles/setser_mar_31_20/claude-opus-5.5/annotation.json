      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "I would differentiate here between two different kinds of funding needs:"
     },
     {
      "paragraph_id": "p17",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
      "review_status": "pending",
