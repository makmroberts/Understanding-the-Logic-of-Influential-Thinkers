   "legacy_id": "E3",
   "role": "evidence_data",
   "level": "L2",
   "content": {
    "text": "Balance of payments shortfalls stem from terms-of-trade shocks for oil exporters, lost financial inflows in South Africa, and a dollarized bank run in Lebanon.",
    "label": null,
    "explicit": true,
    "reason": "Different external shocks produce the same financing gap."
   },
   "source": {
    "passages": [
