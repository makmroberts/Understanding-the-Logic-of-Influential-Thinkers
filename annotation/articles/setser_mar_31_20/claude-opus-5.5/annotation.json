   "legacy_id": "C2",
   "role": "intermediate_claim",
   "level": "L4",
   "content": {
    "text": "Countries whose external debt exceeds their liquid reserves face the hardest problems, because financing dries up exactly when they need it.",
    "label": null,
    "explicit": true,
    "reason": "Private capital is procyclical, fleeing the borrowers who most need it."
   },
   "source": {
    "passages": [
