  {
   "id": "n009",
   "legacy_id": "C1",
   "role": "intermediate_claim",
   "level": "L4",
   "content": {
    "text": "Strong-balance-sheet countries can weather the storm by using public balance sheets and Fed swap lines to backstop leveraged institutions.",
    "label": null,
    "explicit": true,
    "reason": "A public balance sheet can stand in for private balance sheets that lose market access."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p14",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "Countries with strong external balance sheets consequently can weather the storm if they act decisively and use their public sector balance sheet to backstop leveraged financial institutions."
     }
