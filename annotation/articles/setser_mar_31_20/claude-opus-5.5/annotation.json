   "legacy_id": "P1",
   "role": "stated_assumption",
   "level": "L1",
   "content": {
    "text": "Countries with large reserves and net foreign assets can self-finance their shortfalls and avoid immediate adjustment.",
    "label": null,
    "explicit": true,
    "reason": "Accumulated external buffers let a country finance a temporary shortfall instead of adjusting at once."
