  {
   "id": "n015",
   "legacy_id": "REC",
   "role": "recommendation",
   "level": "L5",
   "content": {
    "text": "The IMF should issue an SDR allocation and get more lending resources; MDBs should use callable capital; creditors should defer payments; private bondholders should extend 2020 maturities; and central banks should backstop hedging and trade finance.",
    "label": null,
    "explicit": true,
    "reason": "When global demand for reserves rises, official creation of reserves and lending should rise with it."
   },
