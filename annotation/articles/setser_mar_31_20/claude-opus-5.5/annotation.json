   "legacy_id": "E1",
   "role": "evidence_data",
   "level": "L2",
   "content": {
    "text": "Four shocks hit at once: an oil and commodity price collapse, a manufacturing trade shock from shutdowns, a sudden stop in private flows to emerging markets, and reduced cross-border dollar financing.",
    "label": null,
    "explicit": true,
    "reason": "Prices below balance of payments breakevens signal external financing stress for exporters."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p2",
      "relation": "states",
      "link_method": "llm_citation",
      "anchor_grade": "excerpt",
      "review_status": "pending",
      "source_excerpt": "An oil price shock that has sent the price of Brent oil down to under $25"
     },
