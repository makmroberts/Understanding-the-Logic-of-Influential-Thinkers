   "legacy_id": "K",
   "role": "main_claim",
   "level": "L5",
   "content": {
    "text": "Emerging markets face many distinct crises, not one, and the official sector must step in with tailored tools, home backstops for the strong and IMF and MDB financing for the weak, to limit the shock.",
    "label": null,
    "explicit": true,
    "reason": "Official finance should replace private finance when it withdraws in a crisis."
   },
   "source": {
    "passages": [
     {
