   "legacy_id": "M3",
   "role": "mechanism",
   "level": "L3",
   "content": {
    "text": "Asian insurers and other holders of offshore assets need dollars to hedge currency risk, and thinly capitalized ones face trouble when hedging markets seize.",
    "label": null,
    "explicit": true,
    "reason": "Leveraged holders of foreign assets face funding risk when hedging markets dry up, even if the country is a net creditor."
   },
   "source": {
    "passages": [
     {
      "paragraph_id": "p11",
      "relation": "abstracts",
      "link_method": "llm_citation",
      "anchor_grade": "cited",
