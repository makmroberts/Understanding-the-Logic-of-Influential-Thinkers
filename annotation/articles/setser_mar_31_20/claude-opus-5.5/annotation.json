   "legacy_id": "C3",
   "role": "case_type",
   "level": "L4",
   "content": {
    "text": "Funding needs come in two types: short-term dollar trade finance, and longer-term balance of payments funding for lost inflows, and each needs a different remedy.",
    "label": null,
    "explicit": true,
    "reason": "Liquidity needs and solvency-type financing gaps call for different instruments."
   },
   "source": {
    "passages": [
     {
