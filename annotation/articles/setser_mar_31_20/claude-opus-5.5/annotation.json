   "legacy_id": "P3",
   "role": "hidden_assumption",
   "level": "L1",
   "content": {
    "text": "A creditor country's losses on its institutions can be absorbed domestically, so it faces no external financial risk.",
    "label": null,
    "explicit": false,
    "reason": "A net creditor government can recapitalize domestic institutions in its own currency without external financing."
   },
   "source": {
