 "summary": {
  "central_question": "Given a set of simultaneous global shocks hitting emerging economies, how will their impact differ across countries and what policy responses does each kind of case require?",
  "main_thesis": "Emerging markets face many distinct crises, not one, and the official sector must step in with tailored tools, home backstops for the strong and IMF and MDB financing for the weak, to limit the shock.",
  "argument_summary": null
 },
