   "legacy_id": "QF",
   "role": "caveat",
   "level": "L6",
   "content": {
    "text": "An SDR allocation alone is insufficient because it goes by quota rather than need.",
    "label": null,
    "explicit": true,
    "reason": "Distributing aid by formula rather than need leaves the neediest underfunded."
   },
   "source": {
