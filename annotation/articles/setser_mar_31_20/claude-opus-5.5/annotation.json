   "role": "opposing_view",
   "level": "L6",
   "content": {
    "text": "Private creditors would prefer full payment, but voluntary extension beats default.",
    "label": null,
    "explicit": true,
    "reason": "Creditors gain more from voluntary extension than from disorderly default."
   },
   "source": {
    "passages": [
