   "legacy_id": "P2",
   "role": "stated_assumption",
   "level": "L1",
   "content": {
    "text": "Swap lines fund dollar intermediaries, not current account gaps; balance of payments gaps are normally met by reserves, then the IMF and World Bank.",
    "label": null,
    "explicit": true,
    "reason": "Central bank liquidity lines address funding of intermediaries, while lost external receipts need reserves or official lending."
   },
